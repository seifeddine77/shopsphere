# ============================================================
# PRODUCTION SECRETS TEMPLATE
# Copy to .env.production then run: node src/scripts/generate-secrets.js
# (the generator fills the secrets below automatically)
# ============================================================

# Public domain pointing at this server (A/AAAA record required for TLS)
DOMAIN_NAME=shop.example.com

# ------------------------------------------------------------
# Secrets - filled by src/scripts/generate-secrets.js
# ------------------------------------------------------------
JWT_SECRET=
COOKIE_SECRET=
MONGO_KEYFILE_CONTENT=

# MongoDB credentials (choose strong values)
MONGO_ROOT_PASSWORD=change-me-strong
MONGO_APP_PASSWORD=change-me-too

# ------------------------------------------------------------
# Stripe (optional - simulated gateway used while empty)
# Webhook endpoint: https://<DOMAIN_NAME>/api/payments/stripe/webhook
# Events: payment_intent.succeeded, payment_intent.payment_failed
# ------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
