<%# ---------- ADMIN: Product create / edit form ----------
    Expects: product (JSON or null), categories[], brands[] %>
<% const isEdit = Boolean(product); %>

<div class="d-flex align-items-center gap-2 mb-4">
    <a href="/admin/products" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Back</a>
    <h1 class="h3 fw-bold mb-0"><%= isEdit ? 'Edit product' : 'New product' %></h1>
</div>

<div class="panel" style="max-width:860px">
    <form id="product-form"
          data-endpoint="<%= isEdit ? `/api/products/${product._id}` : '/api/products' %>"
          data-method="<%= isEdit ? 'PUT' : 'POST' %>"
          data-redirect="/admin/products"
          novalidate>
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label" for="pf-name">Name *</label>
                <input class="form-control" id="pf-name" name="name" required minlength="2"
                       value="<%= product ? product.name : '' %>">
            </div>
            <div class="col-12">
                <label class="form-label" for="pf-description">Description * <span class="text-secondary-emphasis small">(min 10 chars)</span></label>
                <textarea class="form-control" id="pf-description" name="description" rows="4" required
                          minlength="10"><%= product ? product.description : '' %></textarea>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label" for="pf-price">Price *</label>
                <input type="number" step="0.01" min="0" class="form-control" id="pf-price" name="price" required
                       value="<%= product ? product.price : '' %>">
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label" for="pf-discount">Discount price</label>
                <input type="number" step="0.01" min="0" class="form-control" id="pf-discount" name="discountPrice"
                       value="<%= product && product.discountPrice != null ? product.discountPrice : '' %>"
                       placeholder="none">
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label" for="pf-stock">Stock *</label>
                <input type="number" step="1" min="0" class="form-control" id="pf-stock" name="stock" required
                       value="<%= product ? product.stock : 0 %>">
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label" for="pf-sku">SKU *</label>
                <input class="form-control" id="pf-sku" name="sku" required <%= isEdit ? 'readonly' : '' %>
                       value="<%= product ? product.sku : '' %>" placeholder="e.g. SS-001">
                <% if (isEdit) { %><div class="form-text">SKU cannot be changed.</div><% } %>
            </div>
            <div class="col-12 col-md-6">
                <label class="form-label" for="pf-category">Category *</label>
                <select class="form-select" id="pf-category" name="category" required>
                    <option value="">Choose...</option>
                    <% categories.forEach((category) => { %>
                        <option value="<%= category._id %>" <%= product && String(product.category && product.category._id || product.category) === category._id ? 'selected' : '' %>><%= category.name %></option>
                    <% }) %>
                </select>
            </div>
            <div class="col-12 col-md-6">
                <label class="form-label" for="pf-brand">Brand *</label>
                <select class="form-select" id="pf-brand" name="brand" required>
                    <option value="">Choose...</option>
                    <% brands.forEach((brand) => { %>
                        <option value="<%= brand._id %>" <%= product && String(product.brand && product.brand._id || product.brand) === brand._id ? 'selected' : '' %>><%= brand.name %></option>
                    <% }) %>
                </select>
            </div>
            <div class="col-12">
                <label class="form-label" for="pf-image">Image path/URL</label>
                <input class="form-control" id="pf-image" name="images"
                       placeholder="/uploads/products/photo.jpg or /images/products/my-product.svg"
                       value="<%= product && product.images && product.images[0] ? product.images[0] : '' %>">
                <div class="d-flex align-items-center gap-3 mt-2">
                    <%# Upload widget (admin-only endpoint, JPEG/PNG/WEBP <= 2 MB) %>
                    <label class="btn btn-outline-secondary btn-sm mb-0">
                        <i class="bi bi-upload me-1"></i>Upload image
                        <input type="file" id="pf-image-file" accept=".jpg,.jpeg,.png,.webp" hidden>
                    </label>
                    <span class="small text-secondary-emphasis js-upload-status" role="status" aria-live="polite"></span>
                </div>
                <img id="pf-image-preview" src="<%= product && product.images && product.images[0] ? product.images[0] : '/images/placeholder.svg' %>"
                     alt="Product image preview" class="mt-2 rounded-3"
                     style="width:120px;height:120px;object-fit:cover">
                <div class="form-text">Paste a path/URL or upload - JPEG, PNG, WEBP up to 2&nbsp;MB.</div>
            </div>
            <div class="col-12 d-flex gap-4">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="pf-active" <%= !product || product.isActive ? 'checked' : '' %>>
                    <label class="form-check-label" for="pf-active">Active (visible in store)</label>
                </div>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="pf-featured" <%= product && product.isFeatured ? 'checked' : '' %>>
                    <label class="form-check-label" for="pf-featured">Featured on home page</label>
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-primary mt-4 px-4 js-submit-form">
            <%= isEdit ? 'Save changes' : 'Create product' %>
        </button>
    </form>
</div>
