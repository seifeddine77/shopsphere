<%# ---------- ADMIN: Media Asset Management Center ----------
    Expects: mediaFiles[] %>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h1 class="h3 fw-bold mb-0">Media Library</h1>
        <p class="text-secondary-emphasis small mb-0">Central repository for product images, banners, and brand assets</p>
    </div>
    <label class="btn btn-primary btn-sm d-flex align-items-center gap-1 mb-0 shadow-sm">
        <i class="bi bi-cloud-arrow-up-fill"></i> Upload Asset
        <input type="file" id="media-upload-input" accept=".jpg,.jpeg,.png,.webp,.svg" hidden multiple>
    </label>
</div>

<%# Upload Drag & Drop Area %>
<div class="card border-dashed rounded-4 p-4 text-center mb-4 bg-body-tertiary" id="media-drop-zone" style="border: 2px dashed var(--bs-border-color);">
    <i class="bi bi-images fs-1 text-primary mb-2 d-block"></i>
    <h6 class="fw-bold mb-1">Drag and drop images here, or click upload</h6>
    <p class="small text-secondary-emphasis mb-0">Supports JPG, PNG, WebP, SVG up to 5 MB each.</p>
</div>

<% if (mediaFiles.length === 0) { %>
    <div class="empty-state">
        <i class="bi bi-image empty-state-icon" aria-hidden="true"></i>
        <p class="mb-0 fw-semibold">No media files uploaded yet</p>
    </div>
<% } else { %>
    <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-xl-6 g-3" id="media-gallery-grid">
        <% mediaFiles.forEach((file) => { %>
            <div class="col">
                <div class="card h-100 border rounded-3 overflow-hidden shadow-sm">
                    <div class="position-relative bg-body-secondary" style="aspect-ratio: 1/1;">
                        <img src="<%= file.url %>" alt="<%= file.name %>" class="w-100 h-100 p-2" style="object-fit: contain;">
                    </div>
                    <div class="card-body p-2 d-flex flex-column">
                        <small class="text-truncate fw-semibold mb-1" title="<%= file.name %>"><%= file.name %></small>
                        <div class="mt-auto d-flex justify-content-between align-items-center pt-1 border-top">
                            <button type="button" class="btn btn-link btn-sm text-primary p-0 js-copy-url" data-url="<%= file.url %>" title="Copy URL">
                                <i class="bi bi-clipboard"></i> Copy URL
                            </button>
                            <small class="text-muted"><%= file.size %></small>
                        </div>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>
<% } %>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const uploadInput = document.getElementById('media-upload-input');
    const dropZone = document.getElementById('media-drop-zone');

    const handleUpload = async (files) => {
        if (!files || !files.length) return;
        window.app.showToast(`Uploading ${files.length} asset(s)...`, 'info');

        for (const file of files) {
            const formData = new FormData();
            formData.append('image', file);
            try {
                const res = await fetch('/api/uploads/image', {
                    method: 'POST',
                    body: formData,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const data = await res.json();
                if (data.success) {
                    window.app.showToast(`Uploaded ${file.name}!`, 'success');
                } else {
                    window.app.showToast(data.message || 'Upload failed', 'danger');
                }
            } catch (err) {
                window.app.showToast('Upload error', 'danger');
            }
        }
        setTimeout(() => window.location.reload(), 800);
    };

    if (uploadInput) {
        uploadInput.addEventListener('change', () => handleUpload(uploadInput.files));
    }

    if (dropZone) {
        dropZone.addEventListener('dragover', (e) => {
            e.preventDefault();
            dropZone.classList.add('bg-primary-subtle');
        });
        dropZone.addEventListener('dragleave', () => {
            dropZone.classList.remove('bg-primary-subtle');
        });
        dropZone.addEventListener('drop', (e) => {
            e.preventDefault();
            dropZone.classList.remove('bg-primary-subtle');
            handleUpload(e.dataTransfer.files);
        });
    }

    document.querySelectorAll('.js-copy-url').forEach((btn) => {
        btn.addEventListener('click', async () => {
            await navigator.clipboard.writeText(btn.dataset.url);
            window.app.showToast('Asset URL copied to clipboard!', 'success');
        });
    });
});
</script>
