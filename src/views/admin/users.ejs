<%# ---------- ADMIN: Users ---------- %>
<h1 class="h3 fw-bold mb-1">Users</h1>
<p class="text-secondary-emphasis small mb-4">
    Administrator accounts are read-only to prevent lockouts. Deactivating a user
    blocks their next request and clears their cart.
</p>

<form class="d-flex gap-2 mb-3" method="get" action="/admin/users" role="search">
    <input type="search" class="form-control" style="max-width:320px" name="q"
           value="<%= currentQ %>" placeholder="Search email or name..." aria-label="Search users">
    <button class="btn btn-outline-secondary" type="submit">Search</button>
    <% if (currentQ) { %><a href="/admin/users" class="btn btn-link text-decoration-none">Clear</a><% } %>
</form>

<% if (users.length === 0) { %>
    <div class="empty-state"><p class="mb-0 fw-semibold">No users match.</p></div>
<% } else { %>
    <div class="table-responsive admin-table">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col">User</th>
                    <th scope="col">Role</th>
                    <th scope="col">Status</th>
                    <th scope="col">Joined</th>
                </tr>
            </thead>
            <tbody>
                <% users.forEach((user) => { %>
                    <% const isSelf = String(user._id) === String(currentUserId); %>
                    <tr data-user-id="<%= user._id %>">
                        <td>
                            <strong><%= user.firstName %> <%= user.lastName %></strong> <%= isSelf ? '<span class="badge bg-primary-subtle text-primary-emphasis ms-1">you</span>' : '' %><br>
                            <small class="text-secondary-emphasis"><%= user.email %></small>
                        </td>
                        <td>
                            <% if (isSelf || user.role === 'ADMIN') { %>
                                <span class="badge <%= user.role === 'ADMIN' ? 'bg-dark' : 'bg-secondary-subtle text-secondary-emphasis' %>"><%= user.role %></span>
                            <% } else { %>
                                <select class="form-select form-select-sm js-role-select" style="width:auto"
                                        data-endpoint="/api/admin/users/<%= user._id %>/role"
                                        aria-label="Role for <%= user.email %>">
                                    <option value="USER" <%= user.role === 'USER' ? 'selected' : '' %>>USER</option>
                                    <option value="ADMIN" <%= user.role === 'ADMIN' ? 'selected' : '' %>>ADMIN</option>
                                </select>
                            <% } %>
                        </td>
                        <td>
                            <% if (isSelf || user.role === 'ADMIN') { %>
                                <span class="badge bg-success-subtle text-success-emphasis"><%= user.isActive ? 'Active' : 'Disabled' %></span>
                            <% } else { %>
                                <div class="form-check form-switch">
                                    <input class="form-check-input js-toggle-field" type="checkbox" role="switch"
                                           data-endpoint="/api/admin/users/<%= user._id %>/status"
                                           data-field="isActive" <%= user.isActive ? 'checked' : '' %>
                                           aria-label="Toggle active for <%= user.email %>">
                                </div>
                            <% } %>
                        </td>
                        <td class="small text-secondary-emphasis"><%= formatDate(user.createdAt) %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    <%- include('../partials/pagination', { pagination, baseQuery }) %>
<% } %>
