<%# ---------- ADMIN: Dashboard ---------- %>
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <h1 class="h3 fw-bold mb-0">Dashboard</h1>
    <span class="text-secondary-emphasis small">Last 6 months overview</span>
</div>

<%# ------------------------------ KPI cards ------------------------------- %>
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="kpi-card">
            <span class="kpi-icon"><i class="bi bi-people" aria-hidden="true"></i></span>
            <div><p class="kpi-value mb-0"><%= stats.totalUsers %></p><p class="kpi-label mb-0">Customers</p></div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="kpi-card revenue">
            <span class="kpi-icon"><i class="bi bi-cash-stack" aria-hidden="true"></i></span>
            <div><p class="kpi-value mb-0"><%= formatPrice(stats.revenue) %></p><p class="kpi-label mb-0">Revenue</p></div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="kpi-card pending">
            <span class="kpi-icon"><i class="bi bi-hourglass-split" aria-hidden="true"></i></span>
            <div><p class="kpi-value mb-0"><%= stats.pendingOrders %></p><p class="kpi-label mb-0">Pending orders</p></div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="kpi-card stock">
            <span class="kpi-icon"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i></span>
            <div><p class="kpi-value mb-0"><%= lowStock.length %></p><p class="kpi-label mb-0">Low stock items</p></div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4 align-items-stretch">
    <%# ---------------------------- Charts ---------------------------- %>
    <div class="col-12 col-xl-8">
        <section class="panel" aria-labelledby="revenue-chart-heading">
            <h2 id="revenue-chart-heading" class="panel-title">Revenue &amp; orders per month</h2>
            <canvas id="monthly-chart" height="110"
                    data-series='<%= JSON.stringify(charts.monthly) %>'
                    aria-label="Bar chart of revenue and orders by month"
                    role="img"></canvas>
        </section>
    </div>
    <div class="col-12 col-xl-4">
        <section class="panel" aria-labelledby="category-chart-heading">
            <h2 id="category-chart-heading" class="panel-title">Sales by category</h2>
            <% if (charts.categories.length === 0) { %>
                <p class="small text-secondary-emphasis mb-0">No sales data yet.</p>
            <% } else { %>
                <canvas id="category-chart" height="220"
                        data-series='<%= JSON.stringify(charts.categories) %>'
                        aria-label="Doughnut chart of revenue by category"
                        role="img"></canvas>
            <% } %>
        </section>
    </div>
</div>

<div class="row g-3">
    <%# --------------------------- Top products --------------------------- %>
    <div class="col-12 col-lg-6">
        <section class="panel" aria-labelledby="top-products-heading">
            <h2 id="top-products-heading" class="panel-title">Top products</h2>
            <% if (charts.topProducts.length === 0) { %>
                <p class="small text-secondary-emphasis mb-0">No orders yet.</p>
            <% } else { %>
                <table class="table table-sm align-middle mb-0">
                    <thead><tr><th scope="col">Product</th><th scope="col" class="text-end">Units</th><th scope="col" class="text-end">Revenue</th></tr></thead>
                    <tbody>
                        <% charts.topProducts.forEach((product) => { %>
                            <tr>
                                <td class="text-truncate" style="max-width:220px"><%= product.name %></td>
                                <td class="text-end"><%= product.units %></td>
                                <td class="text-end"><%= formatPrice(product.revenue) %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } %>
        </section>
    </div>

    <%# ---------------------------- Low stock ----------------------------- %>
    <div class="col-12 col-lg-6">
        <section class="panel" aria-labelledby="low-stock-heading">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <h2 id="low-stock-heading" class="panel-title mb-0">Low stock alerts</h2>
                <a href="/admin/inventory" class="small link-primary text-decoration-none">Manage inventory</a>
            </div>
            <% if (lowStock.length === 0) { %>
                <p class="small text-secondary-emphasis mb-0 mt-2">All products are comfortably stocked.</p>
            <% } else { %>
                <table class="table table-sm align-middle mb-0">
                    <thead><tr><th scope="col">Product</th><th scope="col">SKU</th><th scope="col" class="text-end">Stock</th></tr></thead>
                    <tbody>
                        <% lowStock.forEach((product) => { %>
                            <tr class="<%= product.stock === 0 ? 'table-danger' : '' %>">
                                <td class="text-truncate" style="max-width:200px"><%= product.name %></td>
                                <td><code><%= product.sku %></code></td>
                                <td class="text-end fw-bold"><%= product.stock %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } %>
        </section>
    </div>
</div>
