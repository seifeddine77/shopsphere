<%# ---------- ADMIN: Store settings ---------- %>
<h1 class="h3 fw-bold mb-1">Store settings</h1>
<p class="text-secondary-emphasis small mb-4">
    Values saved here override the environment defaults. Leave a field empty to fall back.
</p>

<div class="panel" style="max-width:560px">
    <form id="settings-form" data-endpoint="/api/admin/settings"
          data-method="PUT" data-redirect="/admin/settings" novalidate>
        <h2 class="panel-title">Shipping</h2>
        <div class="row g-3 mb-4">
            <div class="col-6">
                <label class="form-label" for="set-flat">Flat rate ($)</label>
                <input type="number" step="0.01" min="0" class="form-control" id="set-flat"
                       name="shippingFlatRate" placeholder="<%= envDefaults.flatRate %>"
                       value="<%= settings.shippingFlatRate ?? '' %>">
            </div>
            <div class="col-6">
                <label class="form-label" for="set-threshold">Free shipping threshold ($)</label>
                <input type="number" step="0.01" min="0" class="form-control" id="set-threshold"
                       name="shippingFreeThreshold" placeholder="<%= envDefaults.freeThreshold %>"
                       value="<%= settings.shippingFreeThreshold ?? '' %>">
            </div>
        </div>

        <h2 class="panel-title">Inventory</h2>
        <div class="row g-3 mb-4">
            <div class="col-6">
                <label class="form-label" for="set-lowstock">Low stock threshold (units)</label>
                <input type="number" step="1" min="0" class="form-control" id="set-lowstock"
                       name="lowStockThreshold" placeholder="5"
                       value="<%= settings.lowStockThreshold ?? '' %>">
            </div>
        </div>

        <button type="submit" class="btn btn-primary px-4 js-submit-form">Save settings</button>
    </form>
</div>
