<%# ---------- ADMIN: Navigation Menu Builder ----------
    Expects: headerMenu, footerMenu %>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h1 class="h3 fw-bold mb-0">Menu Builder</h1>
        <p class="text-secondary-emphasis small mb-0">Manage navigation links for Header, Mega Menus, and Footer columns</p>
    </div>
</div>

<div class="row g-4">
    <%# ------------------------- Header Navigation -------------------------- %>
    <div class="col-12 col-xl-6">
        <div class="panel h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="panel-title mb-0"><i class="bi bi-compass me-2 text-primary"></i>Header Navigation</h2>
                <span class="badge bg-primary-subtle text-primary-emphasis"><%= (headerMenu && headerMenu.items) ? headerMenu.items.length : 0 %> Items</span>
            </div>

            <form id="header-menu-form" data-endpoint="/api/admin/menus/HEADER" data-method="PUT">
                <div id="header-menu-items" class="d-flex flex-column gap-2 mb-3">
                    <% if (headerMenu && headerMenu.items && headerMenu.items.length) { %>
                        <% headerMenu.items.forEach((item, i) => { %>
                            <div class="menu-item-row p-2 border rounded-3 bg-body-tertiary d-flex align-items-center gap-2">
                                <span class="text-muted"><i class="bi bi-grip-vertical"></i></span>
                                <input type="text" class="form-control form-control-sm" name="items[<%= i %>].label" value="<%= item.label %>" placeholder="Label" required style="width: 140px;">
                                <input type="text" class="form-control form-control-sm" name="items[<%= i %>].url" value="<%= item.url %>" placeholder="URL (/products)" required>
                                <button type="button" class="btn btn-outline-danger btn-sm js-remove-menu-item"><i class="bi bi-trash"></i></button>
                            </div>
                        <% }) %>
                    <% } %>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="btn-add-header-item">
                        <i class="bi bi-plus-lg me-1"></i> Add Link
                    </button>
                    <button type="submit" class="btn btn-primary btn-sm px-4 js-submit-form">
                        <i class="bi bi-check2 me-1"></i> Save Header Menu
                    </button>
                </div>
            </form>
        </div>
    </div>

    <%# ------------------------- Footer Navigation -------------------------- %>
    <div class="col-12 col-xl-6">
        <div class="panel h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="panel-title mb-0"><i class="bi bi-layout-sidebar-inset me-2 text-primary"></i>Footer Navigation</h2>
                <span class="badge bg-secondary-subtle text-secondary-emphasis"><%= (footerMenu && footerMenu.items) ? footerMenu.items.length : 0 %> Items</span>
            </div>

            <form id="footer-menu-form" data-endpoint="/api/admin/menus/FOOTER" data-method="PUT">
                <div id="footer-menu-items" class="d-flex flex-column gap-2 mb-3">
                    <% if (footerMenu && footerMenu.items && footerMenu.items.length) { %>
                        <% footerMenu.items.forEach((item, i) => { %>
                            <div class="menu-item-row p-2 border rounded-3 bg-body-tertiary d-flex align-items-center gap-2">
                                <span class="text-muted"><i class="bi bi-grip-vertical"></i></span>
                                <input type="text" class="form-control form-control-sm" name="items[<%= i %>].label" value="<%= item.label %>" placeholder="Label" required style="width: 140px;">
                                <input type="text" class="form-control form-control-sm" name="items[<%= i %>].url" value="<%= item.url %>" placeholder="URL (/p/about)" required>
                                <button type="button" class="btn btn-outline-danger btn-sm js-remove-menu-item"><i class="bi bi-trash"></i></button>
                            </div>
                        <% }) %>
                    <% } %>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="btn-add-footer-item">
                        <i class="bi bi-plus-lg me-1"></i> Add Link
                    </button>
                    <button type="submit" class="btn btn-primary btn-sm px-4 js-submit-form">
                        <i class="bi bi-check2 me-1"></i> Save Footer Menu
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    function setupMenuBuilder(addBtnId, containerId) {
        const addBtn = document.getElementById(addBtnId);
        const container = document.getElementById(containerId);
        if (!addBtn || !container) return;

        addBtn.addEventListener('click', () => {
            const index = container.children.length;
            const row = document.createElement('div');
            row.className = 'menu-item-row p-2 border rounded-3 bg-body-tertiary d-flex align-items-center gap-2';
            row.innerHTML = `
                <span class="text-muted"><i class="bi bi-grip-vertical"></i></span>
                <input type="text" class="form-control form-control-sm" name="items[${index}].label" placeholder="Label" required style="width: 140px;">
                <input type="text" class="form-control form-control-sm" name="items[${index}].url" placeholder="URL (/products)" required>
                <button type="button" class="btn btn-outline-danger btn-sm js-remove-menu-item"><i class="bi bi-trash"></i></button>
            `;
            container.appendChild(row);
        });

        container.addEventListener('click', (e) => {
            const removeBtn = e.target.closest('.js-remove-menu-item');
            if (removeBtn) {
                removeBtn.closest('.menu-item-row').remove();
            }
        });
    }

    setupMenuBuilder('btn-add-header-item', 'header-menu-items');
    setupMenuBuilder('btn-add-footer-item', 'footer-menu-items');
});
</script>
