                <div class="text-warning mb-2">
                    <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                </div>
                <p class="small text-secondary-emphasis mb-3">"Flawless checkout experience with Stripe and the AI assistant recommended the exact budget laptop I needed."</p>
                <div class="d-flex align-items-center gap-2 mt-auto">
                    <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px;">K</div>
                    <div>
                        <h6 class="mb-0 small fw-bold">Karim T.</h6>
                        <span class="text-success small" style="font-size: 0.7rem;"><i class="bi bi-patch-check-fill me-1"></i>Verified Buyer</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card border-0 bg-body-tertiary rounded-4 p-4 h-100 shadow-sm">
                <div class="text-warning mb-2">
                    <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                </div>
                <p class="small text-secondary-emphasis mb-3">"Top-tier customer support and smooth returns policy. ShopSphere is now my go-to store for electronics and lifestyle gear."</p>
                <div class="d-flex align-items-center gap-2 mt-auto">
                    <div class="rounded-circle bg-indigo text-white d-flex align-items-center justify-content-center fw-bold bg-dark" style="width: 36px; height: 36px;">E</div>
                    <div>
                        <h6 class="mb-0 small fw-bold">Elena R.</h6>
                        <span class="text-success small" style="font-size: 0.7rem;"><i class="bi bi-patch-check-fill me-1"></i>Verified Buyer</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<%# ---------- Newsletter ---------- %>
<section class="container mb-5" aria-labelledby="newsletter-heading">
    <div class="promo-banner text-center rounded-4 p-5">
        <h2 id="newsletter-heading" class="h3 fw-bold mb-2"><%= t('home.join_newsletter', 'Join our newsletter') %></h2>
        <p class="mb-4 promo-subtitle"><%= t('home.newsletter_subtitle', 'Be first to hear about launches and exclusive offers.') %></p>
        <form class="row justify-content-center g-2 js-newsletter" data-source="home"
              aria-label="Newsletter subscription" novalidate>
            <div class="col-12 col-md-6 col-lg-4">
                <label for="newsletter-email" class="visually-hidden">Email address</label>
                <input type="email" class="form-control" id="newsletter-email" name="email"
                       placeholder="<%= t('home.email_placeholder', 'you@example.com') %>" required>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-dark px-4 js-newsletter-submit"><%= t('home.subscribe', 'Subscribe') %></button>
            </div>
            <p class="small mb-0 mt-2 w-100" role="status" aria-live="polite"
               data-newsletter-feedback></p>
        </form>
    </div>
</section>

