<%# ============================================================
    HOME PAGE - real catalog data.
    Expects: categories[], featuredProducts[], latestProducts[]
    ============================================================ %>

<%# ---------- Hero ---------- %>
<section class="hero-section text-white" aria-labelledby="hero-heading">
    <div class="container py-5">
        <div class="row align-items-center g-5 py-lg-4">
            <div class="col-12 col-lg-7">
                <p class="text-uppercase small fw-semibold letter-spacing mb-2 hero-kicker">New season · New deals</p>
                <h1 id="hero-heading" class="display-4 fw-bold mb-3">Discover products you'll love</h1>
                <p class="lead mb-4 hero-subtitle">
                    Thousands of items, fast delivery and secure checkout - all in one place.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a href="/products" class="btn btn-light btn-lg px-4 fw-semibold">Start shopping</a>
                    <a href="/products?sort=newest" class="btn btn-outline-light btn-lg px-4">See what's new</a>
                </div>
            </div>
            <div class="col-12 col-lg-5 text-center d-none d-lg-block">
                <i class="bi bi-bag-heart hero-art" aria-hidden="true"></i>
            </div>
        </div>
    </div>
</section>

<%# ---------- Value props ---------- %>
<section class="container my-5" aria-label="Our guarantees">
    <div class="row g-4">
        <div class="col-12 col-md-4">
            <div class="value-card h-100">
                <i class="bi bi-truck value-icon" aria-hidden="true"></i>
                <h2 class="h6 fw-bold mt-3 mb-1">Fast shipping</h2>
                <p class="small text-secondary-emphasis mb-0">Free delivery on orders above the threshold.</p>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="value-card h-100">
                <i class="bi bi-shield-check value-icon" aria-hidden="true"></i>
                <h2 class="h6 fw-bold mt-3 mb-1">Secure payment</h2>
                <p class="small text-secondary-emphasis mb-0">Encrypted checkout. Your data stays yours.</p>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="value-card h-100">
                <i class="bi bi-arrow-repeat value-icon" aria-hidden="true"></i>
                <h2 class="h6 fw-bold mt-3 mb-1">Easy returns</h2>
                <p class="small text-secondary-emphasis mb-0">Changed your mind? Returns are simple.</p>
            </div>
        </div>
    </div>
</section>

<%# ---------- Categories ---------- %>
<section class="container my-5" aria-labelledby="categories-heading">
    <h2 id="categories-heading" class="h3 fw-bold mb-4">Shop by category</h2>
    <% if (categories.length === 0) { %>
        <div class="empty-state">
            <i class="bi bi-grid empty-state-icon" aria-hidden="true"></i>
            <p class="mb-1 fw-semibold">No categories yet</p>
        </div>
    <% } else { %>
        <div class="d-flex flex-wrap gap-2">
            <% categories.forEach((category) => { %>
                <a href="/products?category=<%= category.slug %>" class="category-chip">
                    <%= category.name %>
                    <i class="bi bi-arrow-right-short" aria-hidden="true"></i>
                </a>
            <% }) %>
        </div>
    <% } %>
</section>

<%# ---------- Featured products ---------- %>
<section class="container my-5" aria-labelledby="featured-heading">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 id="featured-heading" class="h3 fw-bold mb-0">Featured products</h2>
        <a href="/products?isFeatured=true" class="link-primary small text-decoration-none fw-semibold">
            View all <i class="bi bi-arrow-right" aria-hidden="true"></i>
        </a>
    </div>
    <% if (featuredProducts.length === 0) { %>
        <div class="empty-state">
            <i class="bi bi-star empty-state-icon" aria-hidden="true"></i>
            <p class="mb-1 fw-semibold">No featured products yet</p>
        </div>
    <% } else { %>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-3">
            <% featuredProducts.forEach((product) => { %>
                <div class="col">
                    <%- include('../partials/product-card', { product }) %>
                </div>
            <% }) %>
        </div>
    <% } %>
</section>

<%# ---------- Latest products ---------- %>
<section class="container mb-5" aria-labelledby="latest-heading">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 id="latest-heading" class="h3 fw-bold mb-0">Latest arrivals</h2>
        <a href="/products?sort=newest" class="link-primary small text-decoration-none fw-semibold">
            View all <i class="bi bi-arrow-right" aria-hidden="true"></i>
        </a>
    </div>
    <% if (latestProducts.length === 0) { %>
        <div class="empty-state">
            <i class="bi bi-box-seam empty-state-icon" aria-hidden="true"></i>
            <p class="mb-1 fw-semibold">No products yet</p>
        </div>
    <% } else { %>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-3">
            <% latestProducts.forEach((product) => { %>
                <div class="col">
                    <%- include('../partials/product-card', { product }) %>
                </div>
            <% }) %>
        </div>
    <% } %>
</section>

<%# ---------- Newsletter ---------- %>
<section class="container mb-5" aria-labelledby="newsletter-heading">
    <div class="promo-banner text-center rounded-4 p-5">
        <h2 id="newsletter-heading" class="h3 fw-bold mb-2">Join our newsletter</h2>
        <p class="mb-4 promo-subtitle">Be first to hear about launches and exclusive offers.</p>
        <form class="row justify-content-center g-2 js-newsletter" data-source="home"
              aria-label="Newsletter subscription" novalidate>
            <div class="col-12 col-md-6 col-lg-4">
                <label for="newsletter-email" class="visually-hidden">Email address</label>
                <input type="email" class="form-control" id="newsletter-email" name="email"
                       placeholder="you@example.com" required>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-dark px-4 js-newsletter-submit">Subscribe</button>
            </div>
            <p class="small mb-0 mt-2 w-100" role="status" aria-live="polite"
               data-newsletter-feedback></p>
        </form>
    </div>
</section>
