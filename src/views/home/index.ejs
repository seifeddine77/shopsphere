<%# ============================================================
    HOME PAGE - real catalog data.
    Expects: categories[], featuredProducts[], latestProducts[]
    ============================================================ %>

<%# ---------- Hero ---------- %>
<section class="hero-section text-white" aria-labelledby="hero-heading">
    <div class="container py-5">
        <div class="row align-items-center g-5 py-lg-4">
            <div class="col-12 col-lg-7">
                <p class="text-uppercase small fw-semibold letter-spacing mb-2 hero-kicker"><%= t('home.hero_kicker', 'New season · New deals') %></p>
                <h1 id="hero-heading" class="display-4 fw-bold mb-3"><%= t('home.hero_title', "Discover products you'll love") %></h1>
                <p class="lead mb-4 hero-subtitle">
                    <%= t('home.hero_subtitle', 'Thousands of items, fast delivery and secure checkout - all in one place.') %>
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a href="/products" class="btn btn-light btn-lg px-4 fw-semibold"><%= t('home.start_shopping', 'Start shopping') %></a>
                    <a href="/products?sort=newest" class="btn btn-outline-light btn-lg px-4"><%= t('home.see_whats_new', "See what's new") %></a>
                </div>
            </div>
            <div class="col-12 col-lg-5 text-center d-none d-lg-block">
                <i class="bi bi-bag-heart hero-art" aria-hidden="true"></i>
            </div>
        </div>
    </div>
</section>

<%# ---------- Value props ---------- %>
<section class="container my-5" aria-label="Our guarantees">
    <div class="row g-4">
        <div class="col-12 col-md-4">
            <div class="value-card h-100">
                <i class="bi bi-truck value-icon" aria-hidden="true"></i>
                <h2 class="h6 fw-bold mt-3 mb-1"><%= t('home.fast_shipping_title', 'Fast shipping') %></h2>
                <p class="small text-secondary-emphasis mb-0"><%= t('home.fast_shipping_desc', 'Free delivery on orders above the threshold.') %></p>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="value-card h-100">
                <i class="bi bi-shield-check value-icon" aria-hidden="true"></i>
                <h2 class="h6 fw-bold mt-3 mb-1"><%= t('home.secure_payment_title', 'Secure payment') %></h2>
                <p class="small text-secondary-emphasis mb-0"><%= t('home.secure_payment_desc', 'Encrypted checkout. Your data stays yours.') %></p>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="value-card h-100">
                <i class="bi bi-arrow-repeat value-icon" aria-hidden="true"></i>
                <h2 class="h6 fw-bold mt-3 mb-1"><%= t('home.easy_returns_title', 'Easy returns') %></h2>
                <p class="small text-secondary-emphasis mb-0"><%= t('home.easy_returns_desc', 'Changed your mind? Returns are simple.') %></p>
            </div>
        </div>
    </div>
</section>

<%# ---------- Categories ---------- %>
<section class="container my-5" aria-labelledby="categories-heading">
    <h2 id="categories-heading" class="h3 fw-bold mb-4"><%= t('home.shop_by_category', 'Shop by category') %></h2>
    <% if (categories.length === 0) { %>
        <div class="empty-state">
            <i class="bi bi-grid empty-state-icon" aria-hidden="true"></i>
            <p class="mb-1 fw-semibold">No categories yet</p>
        </div>
    <% } else { %>
        <div class="d-flex flex-wrap gap-2">
            <% categories.forEach((category) => { %>
                <a href="/products?category=<%= category.slug %>" class="category-chip">
                    <%= category.name %>
                    <i class="bi bi-arrow-right-short" aria-hidden="true"></i>
                </a>
            <% }) %>
        </div>
    <% } %>
</section>

<%# ---------- Featured products ---------- %>
<section class="container my-5" aria-labelledby="featured-heading">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 id="featured-heading" class="h3 fw-bold mb-0"><%= t('home.featured_products', 'Featured products') %></h2>
        <a href="/products?isFeatured=true" class="link-primary small text-decoration-none fw-semibold">
            <%= t('home.view_all', 'View all') %> <i class="bi bi-arrow-right" aria-hidden="true"></i>
        </a>
    </div>
    <% if (featuredProducts.length === 0) { %>
        <div class="empty-state">
            <i class="bi bi-star empty-state-icon" aria-hidden="true"></i>
            <p class="mb-1 fw-semibold">No featured products yet</p>
        </div>
    <% } else { %>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-3">
            <% featuredProducts.forEach((product) => { %>
                <div class="col">
                    <%- include('../partials/product-card', { product }) %>
                </div>
            <% }) %>
        </div>
    <% } %>
</section>

<%# ---------- Latest products ---------- %>
<section class="container mb-5" aria-labelledby="latest-heading">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 id="latest-heading" class="h3 fw-bold mb-0"><%= t('home.latest_arrivals', 'Latest arrivals') %></h2>
        <a href="/products?sort=newest" class="link-primary small text-decoration-none fw-semibold">
            <%= t('home.view_all', 'View all') %> <i class="bi bi-arrow-right" aria-hidden="true"></i>
        </a>
    </div>
    <% if (latestProducts.length === 0) { %>
        <div class="empty-state">
            <i class="bi bi-box-seam empty-state-icon" aria-hidden="true"></i>
            <p class="mb-1 fw-semibold">No products yet</p>
        </div>
    <% } else { %>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-3">
            <% latestProducts.forEach((product) => { %>
                <div class="col">
                    <%- include('../partials/product-card', { product }) %>
                </div>
            <% }) %>
        </div>
    <% } %>
</section>

<%# ---------- Flash Deals Promo Banner ---------- %>
<section class="container my-5" aria-label="Limited Time Flash Deals">
    <div class="card border-0 rounded-4 shadow-sm overflow-hidden text-white p-4 p-lg-5"
         style="background: linear-gradient(135deg, #1e1b4b 0%, #4338ca 50%, #6366f1 100%);">
        <div class="row align-items-center g-4">
            <div class="col-12 col-lg-7">
                <span class="badge bg-warning text-dark fw-bold px-3 py-2 text-uppercase mb-3">
                    <i class="bi bi-lightning-charge-fill me-1"></i><%= t('home.flash_sale', 'Limited Time Flash Sale') %>
                </span>
                <h2 class="display-6 fw-bold mb-2"><%= t('home.flash_title', 'Up to 50% Off On Electronics & Essentials') %></h2>
                <p class="lead text-white-50 mb-4"><%= t('home.flash_desc', 'Grab top-tier noise-cancelling audio, modern tech, and premium accessories before stocks run out.') %></p>
                <div class="d-flex flex-wrap gap-2">
                    <a href="/products?sort=popular" class="btn btn-warning text-dark fw-bold px-4 py-2">
                        <%= t('home.shop_deals', 'Claim Deals Now') %> &rarr;
                    </a>
                </div>
            </div>
            <div class="col-12 col-lg-5 text-center">
                <div class="bg-white bg-opacity-10 p-4 rounded-4 backdrop-blur border border-white border-opacity-25">
                    <p class="small text-uppercase tracking-wider fw-bold text-warning mb-2"><%= t('home.deals_expire', 'Flash Sale Countdown') %></p>
                    <div class="d-flex justify-content-center gap-3 text-center">
                        <div class="bg-dark bg-opacity-50 p-2 rounded-3" style="min-width: 60px;">
                            <div class="fs-3 fw-bold text-white" id="flash-hours">14</div>
                            <div class="small text-white-50" style="font-size: 0.7rem;">Hours</div>
                        </div>
                        <div class="fs-3 fw-bold align-self-center">:</div>
                        <div class="bg-dark bg-opacity-50 p-2 rounded-3" style="min-width: 60px;">
                            <div class="fs-3 fw-bold text-white" id="flash-mins">45</div>
                            <div class="small text-white-50" style="font-size: 0.7rem;">Mins</div>
                        </div>
                        <div class="fs-3 fw-bold align-self-center">:</div>
                        <div class="bg-dark bg-opacity-50 p-2 rounded-3" style="min-width: 60px;">
                            <div class="fs-3 fw-bold text-white" id="flash-secs">20</div>
                            <div class="small text-white-50" style="font-size: 0.7rem;">Secs</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

