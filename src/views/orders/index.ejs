<%# ---------- Order history (/orders) ---------- %>

<div class="container py-4">
    <h1 class="h3 fw-bold mb-4">My orders</h1>

    <% if (orders.length === 0) { %>
        <div class="empty-state">
            <i class="bi bi-box-seam empty-state-icon" aria-hidden="true"></i>
            <p class="mb-1 fw-semibold">No orders yet</p>
            <p class="small text-secondary-emphasis">When you place an order it will show up here.</p>
            <a href="/products" class="btn btn-primary mt-2 px-4">Browse products</a>
        </div>
    <% } else { %>
        <div class="order-list">
            <% orders.forEach((order) => { %>
                <a href="/orders/<%= order._id %>" class="order-card">
                    <div>
                        <strong class="me-2"><%= order.orderNumber %></strong>
                        <span class="text-secondary-emphasis small"><%= formatDate(order.createdAt) %></span>
                        <p class="small text-secondary-emphasis mb-0 mt-1">
                            <%= order.items.reduce((sum, i) => sum + i.quantity, 0) %> item(s)
                            · <%= order.items[0].name %><%= order.items.length > 1 ? ` +${order.items.length - 1} more` : '' %>
                        </p>
                    </div>
                    <div class="text-end">
                        <strong><%= formatPrice(order.total) %></strong><br>
                        <span class="badge
                            <%= order.orderStatus === 'CANCELLED' ? 'bg-danger-subtle text-danger-emphasis'
                                 : order.orderStatus === 'DELIVERED' ? 'bg-success-subtle text-success-emphasis'
                                 : 'bg-primary-subtle text-primary-emphasis' %>">
                            <%= order.orderStatus %>
                        </span>
                    </div>
                </a>
            <% }) %>
        </div>

        <%- include('../partials/pagination', { pagination, baseQuery }) %>
    <% } %>
</div>
