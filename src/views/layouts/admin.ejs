<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= typeof title !== 'undefined' && title ? `${title} · ShopSphere Admin` : 'ShopSphere Admin' %></title>
    <link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
    <link href="/css/admin.css" rel="stylesheet">
    <% (typeof stylesheets !== 'undefined' ? stylesheets : []).forEach((href) => { %>
    <link href="<%= href %>" rel="stylesheet">
    <% }) %>
</head>
<body class="admin-body d-flex">

    <%# ------------------------------ Sidebar ------------------------------- %>
    <nav class="admin-sidebar" aria-label="Admin navigation">
        <a class="admin-brand d-flex align-items-center gap-2" href="/admin">
            <i class="bi bi-speedometer2" aria-hidden="true"></i>
            <span>Shop<b>Sphere</b></span>
            <span class="badge bg-dark ms-auto">Admin</span>
        </a>

        <ul class="admin-nav list-unstyled">
            <li><a href="/admin" class="<%= typeof activeNav !== 'undefined' && activeNav === 'dashboard' ? 'active' : '' %>"><i class="bi bi-graph-up-arrow me-2"></i>Dashboard</a></li>
            <li><a href="/admin/products" class="<%= typeof activeNav !== 'undefined' && activeNav === 'products' ? 'active' : '' %>"><i class="bi bi-box-seam me-2"></i>Products</a></li>
            <li><a href="/admin/categories" class="<%= typeof activeNav !== 'undefined' && activeNav === 'categories' ? 'active' : '' %>"><i class="bi bi-tags me-2"></i>Categories</a></li>
            <li><a href="/admin/brands" class="<%= typeof activeNav !== 'undefined' && activeNav === 'brands' ? 'active' : '' %>"><i class="bi bi-award me-2"></i>Brands</a></li>
            <li><a href="/admin/inventory" class="<%= typeof activeNav !== 'undefined' && activeNav === 'inventory' ? 'active' : '' %>"><i class="bi bi-clipboard-data me-2"></i>Inventory</a></li>
            <li><a href="/admin/orders" class="<%= typeof activeNav !== 'undefined' && activeNav === 'orders' ? 'active' : '' %>"><i class="bi bi-receipt me-2"></i>Orders</a></li>
            <li><a href="/admin/coupons" class="<%= typeof activeNav !== 'undefined' && activeNav === 'coupons' ? 'active' : '' %>"><i class="bi bi-ticket-perforated me-2"></i>Coupons</a></li>
            <li><a href="/admin/reviews" class="<%= typeof activeNav !== 'undefined' && activeNav === 'reviews' ? 'active' : '' %>">
                <i class="bi bi-star-half me-2"></i>Reviews
                <% if (typeof pendingReviewsCount !== 'undefined' && pendingReviewsCount > 0) { %>
                    <span class="badge rounded-pill text-bg-warning ms-1"><%= pendingReviewsCount %></span>
                <% } %>
            </a></li>
            <li><a href="/admin/users" class="<%= typeof activeNav !== 'undefined' && activeNav === 'users' ? 'active' : '' %>"><i class="bi bi-people me-2"></i>Users</a></li>
            <li><a href="/admin/settings" class="<%= typeof activeNav !== 'undefined' && activeNav === 'settings' ? 'active' : '' %>"><i class="bi bi-gear me-2"></i>Settings</a></li>
        </ul>

        <div class="mt-auto p-3 small">
            <a href="/" class="d-block text-decoration-none mb-2"><i class="bi bi-shop me-2"></i>View store</a>
            <button type="button" class="btn btn-link btn-sm text-danger p-0 text-decoration-none" data-action="logout">
                <i class="bi bi-box-arrow-right me-2"></i>Logout
            </button>
        </div>
    </nav>

    <%# ------------------------------ Content ------------------------------- %>
    <div class="admin-content flex-grow-1 d-flex flex-column min-vh-100">
        <main class="flex-grow-1 p-3 p-lg-4">
            <%- body %>
        </main>
        <footer class="text-center small text-secondary-emphasis py-3 border-top">
            ShopSphere administration · built with Node.js &amp; Express
        </footer>
    </div>

    <div class="toast-container position-fixed bottom-0 end-0 p-3" id="flash-container"
         aria-live="polite" aria-atomic="true"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>
    <script src="/js/main.js" defer></script>
    <script src="/js/admin-pages.js" defer></script>
    <% if (typeof scripts !== 'undefined') { %>
        <% scripts.forEach((src) => { %>
        <script src="<%= src %>" defer></script>
        <% }) %>
    <% } %>
</body>
</html>
