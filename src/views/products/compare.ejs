<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="/"><%= t('nav.home', 'Home') %></a></li>
            <li class="breadcrumb-item"><a href="/products"><%= t('nav.shop', 'Shop') %></a></li>
            <li class="breadcrumb-item active" aria-current="page"><%= t('compare.title', 'Compare Products') %></li>
        </ol>
    </nav>

    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h2 fw-bold mb-1"><%= t('compare.title', 'Compare Products') %></h1>
            <p class="text-secondary-emphasis mb-0"><%= t('compare.empty_desc', 'Side-by-side technical and price comparison') %></p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <% if (products && products.length > 0) { %>
                <button type="button" class="btn btn-outline-danger btn-sm js-clear-comparison">
                    <i class="bi bi-trash3 me-1"></i>Clear all
                </button>
            <% } %>
            <a href="/products" class="btn btn-outline-primary btn-sm"><i class="bi bi-arrow-left me-1"></i><%= t('cart.continue_shopping', 'Back to catalog') %></a>
        </div>
    </div>

    <% if (!products || products.length === 0) { %>
        <div class="empty-state my-5 text-center p-5 bg-body-tertiary rounded-4 border">
            <i class="bi bi-sliders fs-1 text-muted mb-3 d-block"></i>
            <h3 class="h5 fw-bold"><%= t('compare.empty_title', 'No products selected for comparison') %></h3>
            <p class="text-secondary-emphasis max-w-md mx-auto mb-4"><%= t('compare.empty_desc', 'Select up to 4 products from the catalog to compare their specifications side by side.') %></p>
            <div class="d-flex justify-content-center gap-2">
                <a href="/products" class="btn btn-primary px-4"><%= t('compare.browse_catalog', 'Browse catalog') %></a>
                <button type="button" class="btn btn-outline-secondary px-3 js-clear-comparison">Reset compare list</button>
            </div>
        </div>
    <% } else { %>
        <div class="table-responsive bg-body-tertiary rounded-4 border shadow-sm p-3">
            <table class="table table-bordered align-middle text-center mb-0 bg-transparent">
                <thead>
                    <tr>
                        <th style="width: 200px;" class="text-start bg-body text-secondary-emphasis fw-bold"><%= t('compare.feature', 'Product') %></th>
                        <% products.forEach((p) => { %>
                            <th style="min-width: 240px;" class="bg-body" data-compare-product-id="<%= p._id %>">
                                <div class="position-relative p-2">
                                    <button type="button" class="btn-close position-absolute top-0 end-0 m-1 js-remove-compare-item" data-product-id="<%= p._id %>" aria-label="Remove <%= p.name %> from comparison"></button>
                                    <img src="<%= (p.images && p.images[0]) || '/images/placeholder.svg' %>" 
                                         alt="<%= p.name %>" class="img-fluid rounded mb-2" style="height: 140px; object-fit: contain;">
                                    <h6 class="fw-bold mb-1"><a href="/products/<%= p.slug %>" class="text-reset text-decoration-none"><%= p.name %></a></h6>
                                    <span class="fs-5 fw-bold text-primary d-block mb-2"><%= formatPrice(p.effectivePrice || p.price) %></span>
                                    <button type="button" class="btn btn-primary btn-sm w-100 js-add-to-cart" data-product-id="<%= p._id %>" data-stock="<%= p.stock %>">
                                        <i class="bi bi-cart-plus me-1"></i><%= t('product.add_to_cart', 'Add to cart') %>
                                    </button>
                                </div>
                            </th>
                        <% }) %>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <th class="text-start bg-body text-secondary-emphasis"><%= t('compare.rating', 'Rating') %></th>
                        <% products.forEach((p) => { %>
                            <td>
                                <%- include('../partials/star-rating', { rating: p.rating, count: p.reviewCount }) %>
                            </td>
                        <% }) %>
                    </tr>
                    <tr>
                        <th class="text-start bg-body text-secondary-emphasis"><%= t('compare.brand', 'Brand') %></th>
                        <% products.forEach((p) => { %>
                            <td><%= (p.brand && p.brand.name) || '-' %></td>
                        <% }) %>
                    </tr>
                    <tr>
                        <th class="text-start bg-body text-secondary-emphasis"><%= t('compare.category', 'Category') %></th>
                        <% products.forEach((p) => { %>
                            <td><%= (p.category && p.category.name) || '-' %></td>
                        <% }) %>
                    </tr>
                    <tr>
                        <th class="text-start bg-body text-secondary-emphasis"><%= t('compare.stock', 'Stock Status') %></th>
                        <% products.forEach((p) => { %>
                            <td>
                                <% if (p.stock > 0) { %>
                                    <span class="badge bg-success-subtle text-success-emphasis"><%= t('product.in_stock', 'In stock') %> (<%= p.stock %>)</span>
                                <% } else { %>
                                    <span class="badge bg-danger-subtle text-danger-emphasis"><%= t('product.out_of_stock', 'Out of stock') %></span>
                                <% } %>
                            </td>
                        <% }) %>
                    </tr>
                    <tr>
                        <th class="text-start bg-body text-secondary-emphasis"><%= t('product.sku', 'SKU') %></th>
                        <% products.forEach((p) => { %>
                            <td><code><%= p.sku %></code></td>
                        <% }) %>
                    </tr>

                    <% if (specKeys && specKeys.length > 0) { %>
                        <tr>
                            <th colspan="<%= products.length + 1 %>" class="text-start bg-body-secondary fw-bold text-uppercase small letter-spacing py-2"><%= t('product.tab_specs', 'Specifications') %></th>
                        </tr>
                        <% specKeys.forEach((key) => { %>
                            <tr>
                                <th class="text-start bg-body text-secondary-emphasis"><%= key %></th>
                                <% products.forEach((p) => { %>
                                    <td>
                                        <% 
                                          let val = '-';
                                          if (p.specifications) {
                                            if (p.specifications instanceof Map) val = p.specifications.get(key) || '-';
                                            else val = p.specifications[key] || '-';
                                          }
                                        %>
                                        <%= val %>
                                    </td>
                                <% }) %>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const COMPARE_KEY = 'shopsphere_compare_items';
  const url = new URL(window.location.href);
  const idsParam = url.searchParams.get('ids');

  let stored = [];
  try {
    stored = JSON.parse(localStorage.getItem(COMPARE_KEY) || '[]');
  } catch (_e) {
    stored = [];
  }

  // Case 1: Page has rendered comparison cards from server
  const renderedCards = document.querySelectorAll('[data-compare-product-id]');
  if (renderedCards.length > 0) {
    const validIds = Array.from(renderedCards).map((el) => el.dataset.compareProductId);
    localStorage.setItem(COMPARE_KEY, JSON.stringify(validIds));
    if (window.app && window.app.updateCompareBadge) window.app.updateCompareBadge();
  } else if (stored.length > 0) {
    // Case 2: No cards rendered, but localStorage has items -> load them
    const storedParam = stored.join(',');
    if (idsParam !== storedParam) {
      window.location.replace('/compare?ids=' + storedParam);
    }
  } else if (idsParam) {
    // Case 3: Stale IDs in URL and no valid items -> clean URL bar
    window.history.replaceState({}, '', '/compare');
  }

  // Clear all button handler
  document.querySelectorAll('.js-clear-comparison').forEach((btn) => {
    btn.addEventListener('click', () => {
      localStorage.removeItem(COMPARE_KEY);
      if (window.app && window.app.updateCompareBadge) window.app.updateCompareBadge();
      window.location.href = '/compare';
    });
  });

  // Remove single product from comparison table
  document.querySelectorAll('.js-remove-compare-item').forEach((btn) => {
    btn.addEventListener('click', () => {
      const pid = btn.dataset.productId;
      try {
        let current = JSON.parse(localStorage.getItem(COMPARE_KEY) || '[]');
        current = current.filter((id) => id !== pid);
        localStorage.setItem(COMPARE_KEY, JSON.stringify(current));
        if (window.app && window.app.updateCompareBadge) window.app.updateCompareBadge();
        if (current.length > 0) {
          window.location.href = '/compare?ids=' + current.join(',');
        } else {
          window.location.href = '/compare';
        }
      } catch (_e) {}
    });
  });
});
</script>


