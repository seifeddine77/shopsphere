<%# ---------- Product catalog (/products) ----------
    Expects: products[], pagination, categories[], brands[],
             current (req.query snapshot), baseQuery (querystring w/o page) %>

<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <% if (current.category) { %>
                <li class="breadcrumb-item"><a href="/products">Shop</a></li>
                <li class="breadcrumb-item active" aria-current="page"><%= current.category %></li>
            <% } else { %>
                <li class="breadcrumb-item active" aria-current="page">Shop</li>
            <% } %>
        </ol>
    </nav>

    <h1 class="h3 fw-bold mb-1">
        <% if (current.q) { %>Results for &ldquo;<%= current.q %>&rdquo;
        <% } else if (current.category) { %><%= categories.find((c) => c.slug === current.category)?.name || current.category %>
        <% } else { %>All products<% } %>
    </h1>
    <p class="text-secondary-emphasis small mb-4">
        <%= pagination.totalItems %> product<%= pagination.totalItems === 1 ? '' : 's' %> found
    </p>

    <form method="get" action="/products" id="catalog-filters" aria-label="Product filters">
        <%# Preserve the search term across filter submissions %>
        <% if (current.q) { %><input type="hidden" name="q" value="<%= current.q %>"><% } %>

        <div class="row g-4">
            <%# ------------------------- Sidebar ------------------------- %>
            <aside class="col-12 col-lg-3">
                <div class="filter-panel">
                    <h2 class="filter-heading">Category</h2>
                    <ul class="filter-list list-unstyled">
                        <li>
                            <label class="filter-option">
                                <input type="radio" name="category" value=""
                                       <%= !current.category ? 'checked' : '' %>>
                                <span>All categories</span>
                            </label>
                        </li>
                        <% categories.forEach((category) => { %>
                            <li>
                                <label class="filter-option">
                                    <input type="radio" name="category" value="<%= category.slug %>"
                                           <%= current.category === category.slug ? 'checked' : '' %>>
                                    <span><%= category.name %></span>
                                </label>
                            </li>
                        <% }) %>
                    </ul>
                </div>

                <div class="filter-panel">
                    <h2 class="filter-heading">Brand</h2>
                    <ul class="filter-list list-unstyled">
                        <li>
                            <label class="filter-option">
                                <input type="radio" name="brand" value=""
                                       <%= !current.brand ? 'checked' : '' %>>
                                <span>All brands</span>
                            </label>
                        </li>
                        <% brands.forEach((brand) => { %>
                            <li>
                                <label class="filter-option">
                                    <input type="radio" name="brand" value="<%= brand.slug %>"
                                           <%= current.brand === brand.slug ? 'checked' : '' %>>
                                    <span><%= brand.name %></span>
                                </label>
                            </li>
                        <% }) %>
                    </ul>
                </div>

                <div class="filter-panel">
                    <h2 class="filter-heading">Price</h2>
                    <div class="d-flex gap-2 align-items-center">
                        <label class="visually-hidden" for="filter-min-price">Minimum price</label>
                        <input type="number" step="0.01" min="0" class="form-control form-control-sm"
                               id="filter-min-price" name="minPrice" placeholder="Min"
                               value="<%= current.minPrice || '' %>">
                        <span class="text-secondary-emphasis">&ndash;</span>
                        <label class="visually-hidden" for="filter-max-price">Maximum price</label>
                        <input type="number" step="0.01" min="0" class="form-control form-control-sm"
                               id="filter-max-price" name="maxPrice" placeholder="Max"
                               value="<%= current.maxPrice || '' %>">
                    </div>
                </div>

                <div class="filter-panel">
                    <h2 class="filter-heading">Rating</h2>
                    <label class="visually-hidden" for="filter-min-rating">Minimum rating</label>
                    <select id="filter-min-rating" name="minRating" class="form-select form-select-sm">
                        <option value="">Any rating</option>
                        <option value="3" <%= current.minRating === '3' ? 'selected' : '' %>>3+ stars</option>
                        <option value="4" <%= current.minRating === '4' ? 'selected' : '' %>>4+ stars</option>
                        <option value="4.5" <%= current.minRating === '4.5' ? 'selected' : '' %>>4.5+ stars</option>
                    </select>
                </div>

                <div class="filter-panel">
                    <label class="filter-option">
                        <input type="checkbox" name="inStock" value="true"
                               <%= current.inStock === 'true' ? 'checked' : '' %>>
                        <span>In stock only</span>
                    </label>
                </div>

                <button type="submit" class="btn btn-primary w-100">Apply filters</button>
                <a href="/products" class="btn btn-link btn-sm w-100 mt-2 text-decoration-none">Reset all</a>
            </aside>

            <%# ------------------------- Results ------------------------- %>
            <section class="col-12 col-lg-9" aria-label="Product results">
                <div class="d-flex justify-content-between align-items-center mb-3 catalog-toolbar">
                    <p class="small text-secondary-emphasis mb-0">
                        Page <%= pagination.currentPage %> of <%= pagination.totalPages %>
                    </p>
                    <div class="d-flex align-items-center gap-2">
                        <label for="sort-select" class="small text-secondary-emphasis mb-0">Sort by</label>
                        <select id="sort-select" name="sort" class="form-select form-select-sm w-auto js-auto-submit">
                            <option value="" <%= !current.sort ? 'selected' : '' %>>Newest</option>
                            <option value="price_asc" <%= current.sort === 'price_asc' ? 'selected' : '' %>>Price: low to high</option>
                            <option value="price_desc" <%= current.sort === 'price_desc' ? 'selected' : '' %>>Price: high to low</option>
                            <option value="best_rating" <%= current.sort === 'best_rating' ? 'selected' : '' %>>Best rated</option>
                            <option value="popular" <%= current.sort === 'popular' ? 'selected' : '' %>>Most popular</option>
                            <option value="oldest" <%= current.sort === 'oldest' ? 'selected' : '' %>>Oldest</option>
                        </select>
                    </div>
                </div>

                <% if (products.length === 0) { %>
                    <div class="empty-state">
                        <i class="bi bi-search empty-state-icon" aria-hidden="true"></i>
                        <p class="mb-1 fw-semibold">No products match your criteria</p>
                        <p class="small text-secondary-emphasis">Try adjusting the filters or search term.</p>
                        <a href="/products" class="btn btn-outline-primary btn-sm">Clear everything</a>
                    </div>
                <% } else { %>
                    <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-3 g-3">
                        <% products.forEach((product) => { %>
                            <div class="col">
                                <%- include('../partials/product-card', { product }) %>
                            </div>
                        <% }) %>
                    </div>
                <% } %>

                <%- include('../partials/pagination', { pagination, baseQuery }) %>
            </section>
        </div>
    </form>
</div>
