<%# ---------- Product detail (/products/:slug) ----------
    Expects: product (plain JSON), related[] %>
<%
  const hasDiscount = product.discountPrice != null;
  const outOfStock = !product.stock || product.stock <= 0;
  const images = product.images && product.images.length ? product.images : ['/images/placeholder.svg'];
%>

<div class="container py-4" data-product-id="<%= product._id %>" data-product-name="<%= product.name %>" data-product-slug="<%= product.slug %>" data-product-price="<%= product.effectivePrice || product.price %>" data-product-image="<%= images[0] %>">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="/"><%= t('nav.home', 'Home') %></a></li>
            <li class="breadcrumb-item"><a href="/products"><%= t('nav.shop', 'Shop') %></a></li>
            <% if (product.category) { %>
                <li class="breadcrumb-item">
                    <a href="/products?category=<%= product.category.slug %>"><%= product.category.name %></a>
                </li>
            <% } %>
            <li class="breadcrumb-item active text-truncate" aria-current="page"><%= product.name %></li>
        </ol>
    </nav>

    <div class="row g-5">
        <%# ------------------------------ Gallery ------------------------------ %>
        <div class="col-12 col-md-6">
            <figure class="gallery mb-0" id="product-gallery">
                <div class="gallery-zoom-container position-relative overflow-hidden rounded-4 border bg-body">
                    <img id="gallery-main" src="<%= images[0] %>" alt="<%= product.name %>"
                         class="gallery-main rounded-4">
                </div>
                <% if (images.length > 1) { %>
                    <div class="d-flex gap-2 mt-3 flex-wrap" role="listbox" aria-label="Product images">
                        <% images.forEach((src, index) => { %>
                            <button type="button"
                                    class="gallery-thumb btn p-0 <%= index === 0 ? 'active' : '' %>"
                                    data-src="<%= src %>"
                                    aria-label="View image <%= index + 1 %> of <%= images.length %>">
                                <img src="<%= src %>" alt="" loading="lazy">
                            </button>
                        <% }) %>
                    </div>
                <% } %>
            </figure>
        </div>

        <%# -------------------------------- Info -------------------------------- %>
        <div class="col-12 col-md-6">
            <% if (product.brand && product.brand.name) { %>
                <p class="text-uppercase small fw-semibold letter-spacing text-primary mb-1">
                    <i class="bi bi-tag-fill me-1"></i><%= product.brand.name %>
                </p>
            <% } %>

            <h1 class="h2 fw-bold"><%= product.name %></h1>

            <div class="d-flex align-items-center gap-3 mb-3">
                <%- include('../partials/star-rating', { rating: product.rating, count: product.reviewCount }) %>
                <span class="text-secondary-emphasis small border-start ps-3"><%= t('product.sku', 'SKU') %>: <code class="text-body"><%= product.sku %></code></span>
            </div>

            <div class="d-flex align-items-baseline gap-2 mb-3">
                <span class="display-6 fw-bold price-current text-primary"><%= formatPrice(product.effectivePrice) %></span>
                <% if (hasDiscount) { %>
                    <s class="fs-5 text-secondary-emphasis"><%= formatPrice(product.price) %></s>
                    <span class="badge badge-discount fs-6">-<%= discountPercent(product) %>%</span>
                <% } %>
            </div>

            <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                <% if (outOfStock) { %>
                    <span class="badge bg-danger-subtle text-danger-emphasis px-3 py-2 border border-danger-subtle">
                        <i class="bi bi-x-circle me-1"></i><%= t('product.out_of_stock', 'Out of stock') %>
                    </span>
                <% } else if (product.stock <= 10) { %>
                    <span class="badge bg-warning-subtle text-warning-emphasis px-3 py-2 border border-warning-subtle">
                        <%= t('product.low_stock', `Low stock - only ${product.stock} left`, { stock: product.stock }) %>
                    </span>
                <% } else { %>
                    <span class="badge bg-success-subtle text-success-emphasis px-3 py-2 border border-success-subtle">
                        <i class="bi bi-check-circle-fill me-1"></i><%= t('product.in_stock', 'In Stock') %>
                    </span>
                <% } %>
            </div>

            <p class="text-body-secondary mb-4"><%= String(product.description).slice(0, 220) %><%= product.description.length > 220 ? '...' : '' %></p>

            <%# --------------------------- Dynamic Variants ----------------------- %>
            <% if (product.variants && product.variants.length > 0) { %>
                <div class="product-variants mb-4 p-3 bg-body-tertiary rounded-3 border">
                    <label class="form-label small fw-bold text-uppercase text-secondary-emphasis mb-2"><%= t('product.options', 'Options & Variations') %></label>
                    <div class="d-flex flex-wrap gap-2" id="variant-selector-group" role="radiogroup" aria-label="Product options">
                        <% product.variants.forEach((v, idx) => { %>
                            <button type="button" 
                                    class="btn btn-outline-primary btn-sm variant-pill js-variant-btn <%= idx === 0 ? 'active' : '' %>"
                                    data-variant-id="<%= v._id %>"
                                    data-variant-name="<%= v.name %>"
                                    data-price="<%= v.effectivePrice || v.price %>"
                                    data-stock="<%= v.stock %>"
                                    data-sku="<%= v.sku || product.sku %>">
                                <strong><%= v.name %></strong>
                                <span class="ms-1 opacity-75">&bull; <%= formatPrice(v.effectivePrice || v.price) %></span>
                            </button>
                        <% }) %>
                    </div>
                </div>
            <% } %>

            <%# --------------------------- Purchase row ---------------------------- %>
            <div class="purchase-row d-flex flex-wrap align-items-center gap-3">
                <div class="qty-stepper input-group" data-stock="<%= product.stock %>">
                    <button type="button" class="btn btn-outline-secondary js-qty-decrease"
                            aria-label="Decrease quantity">&minus;</button>
                    <label for="qty-input" class="visually-hidden">Quantity</label>
                    <input type="number" id="qty-input" class="form-control text-center js-qty"
                           value="1" min="1" max="<%= Math.max(product.stock, 1) %>"
                           <%= outOfStock ? 'disabled' : '' %>>
                    <button type="button" class="btn btn-outline-secondary js-qty-increase"
                            aria-label="Increase quantity">+</button>
                </div>

                <% if (outOfStock) { %>
                    <button class="btn btn-secondary btn-lg flex-grow-1" disabled aria-disabled="true">
                        <i class="bi bi-x-circle me-2" aria-hidden="true"></i><%= t('product.out_of_stock', 'Out of stock') %>
                    </button>
                    <div class="w-100 mt-2 p-3 bg-body-tertiary rounded-3 border">
                        <div class="d-flex align-items-center gap-2 mb-1 text-primary fw-semibold small">
                            <i class="bi bi-bell-fill"></i> <%= t('product.back_in_stock_title', 'Back in Stock Notification') %>
                        </div>
                        <p class="small text-muted mb-2"><%= t('product.back_in_stock_desc', 'Leave your email to get alerted as soon as this item is back in stock.') %></p>
                        <form class="d-flex gap-2 js-stock-alert-form" data-product-id="<%= product._id %>">
                            <input type="email" class="form-control form-control-sm js-stock-alert-email" placeholder="your@email.com"
                                   value="<%= currentUser ? currentUser.email : '' %>" required aria-label="Email for stock alert">
                            <button type="submit" class="btn btn-sm btn-primary flex-shrink-0"><%= t('product.notify_me', 'Notify Me') %></button>
                        </form>
                    </div>
                <% } else { %>
                    <button type="button" class="btn btn-primary btn-lg flex-grow-1 js-add-to-cart"
                            data-product-id="<%= product._id %>" data-stock="<%= product.stock %>">
                        <i class="bi bi-cart-plus me-2" aria-hidden="true"></i><%= t('product.add_to_cart', 'Add to cart') %>
                    </button>
                <% } %>

                <button type="button" class="btn btn-outline-danger btn-lg js-add-to-wishlist"
                        data-product-id="<%= product._id %>"
                        aria-label="Add <%= product.name %> to wishlist" title="<%= t('product.save_wishlist', 'Save to wishlist') %>">
                    <i class="bi bi-heart" aria-hidden="true"></i>
                </button>
                <button type="button" class="btn btn-outline-secondary btn-lg js-add-to-compare"
                        data-product-id="<%= product._id %>"
                        aria-label="Compare <%= product.name %>" title="<%= t('product.compare', 'Compare product') %>">
                    <i class="bi bi-arrow-left-right" aria-hidden="true"></i>
                </button>
            </div>

            <%# --------------------- Social Share & Reassurance -------------------- %>
            <div class="d-flex align-items-center gap-2 mt-4 pt-3 border-top">
                <span class="small text-secondary-emphasis fw-semibold"><i class="bi bi-share me-1"></i><%= t('product.share', 'Share') %>:</span>
                <a href="https://api.whatsapp.com/send?text=<%= encodeURIComponent(product.name + ' - check this out!') %>" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-success rounded-circle p-1 px-2" title="Share on WhatsApp">
                    <i class="bi bi-whatsapp"></i>
                </a>
                <a href="https://twitter.com/intent/tweet?text=<%= encodeURIComponent(product.name) %>" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-dark rounded-circle p-1 px-2" title="Share on X">
                    <i class="bi bi-twitter-x"></i>
                </a>
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-0 small js-copy-link" data-url="" title="Copy Link">
                    <i class="bi bi-link-45deg me-1"></i><%= t('product.copy_link', 'Copy Link') %>
                </button>
            </div>

            <%# --------------------- Trust & Reassurance Badges -------------------- %>
            <div class="row g-2 mt-2 text-secondary-emphasis" style="font-size: 0.8rem;">
                <div class="col-6 col-sm-3 d-flex align-items-center gap-2">
                    <i class="bi bi-truck text-primary fs-5"></i>
                    <span><%= t('product.fast_delivery', 'Fast Delivery') %></span>
                </div>
                <div class="col-6 col-sm-3 d-flex align-items-center gap-2">
                    <i class="bi bi-shield-check text-success fs-5"></i>
                    <span><%= t('product.warranty', '2-Yr Warranty') %></span>
                </div>
                <div class="col-6 col-sm-3 d-flex align-items-center gap-2">
                    <i class="bi bi-arrow-counterclockwise text-primary fs-5"></i>
                    <span><%= t('product.return_policy', '30-Day Return') %></span>
                </div>
                <div class="col-6 col-sm-3 d-flex align-items-center gap-2">
                    <i class="bi bi-lock-fill text-warning fs-5"></i>
                    <span><%= t('product.secure_checkout', 'SSL Secure') %></span>
                </div>
            </div>
        </div>
    </div>

    <%# --------------------- JSON-LD Structured SEO Schema ------------------- %>
    <%
      const jsonLdData = {
        "@context": "https://schema.org/",
        "@type": "Product",
        "name": product.name,
        "image": images,
        "description": product.description || '',
        "sku": product.sku || '',
        "brand": {
          "@type": "Brand",
          "name": (product.brand && product.brand.name) || 'ShopSphere'
        },
        "offers": {
          "@type": "Offer",
          "priceCurrency": "USD",
          "price": product.effectivePrice || product.price,
          "availability": outOfStock ? "https://schema.org/OutOfStock" : "https://schema.org/InStock"
        }
      };
      if (product.rating && product.reviewCount) {
        jsonLdData.aggregateRating = {
          "@type": "AggregateRating",
          "ratingValue": product.rating,
          "reviewCount": product.reviewCount
        };
      }
      const safeJsonLd = JSON.stringify(jsonLdData).replace(/</g, '\\u003c').replace(/>/g, '\\u003e');
    %>
    <script type="application/ld+json"><%- safeJsonLd %></script>

    <%# ------------------------------ Structured Tabs ------------------------------- %>
    <section class="mt-5" aria-labelledby="product-tabs-section">
        <ul class="nav nav-tabs nav-fill mb-4" id="productTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active fw-bold" id="overview-tab" data-bs-toggle="tab" data-bs-target="#tab-overview" type="button" role="tab" aria-controls="tab-overview" aria-selected="true">
                    <i class="bi bi-card-text me-1"></i><%= t('product.tab_description', 'Description') %>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-bold" id="specs-tab" data-bs-toggle="tab" data-bs-target="#tab-specs" type="button" role="tab" aria-controls="tab-specs" aria-selected="false">
                    <i class="bi bi-cpu me-1"></i><%= t('product.tab_specs', 'Specifications') %>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-bold" id="shipping-tab" data-bs-toggle="tab" data-bs-target="#tab-shipping" type="button" role="tab" aria-controls="tab-shipping" aria-selected="false">
                    <i class="bi bi-box-seam me-1"></i><%= t('product.tab_shipping', 'Shipping & Returns') %>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-bold" id="reviews-tab" data-bs-toggle="tab" data-bs-target="#tab-reviews" type="button" role="tab" aria-controls="tab-reviews" aria-selected="false">
                    <i class="bi bi-chat-heart me-1"></i><%= t('product.tab_reviews', 'Reviews') %> (<%= product.reviewCount || 0 %>)
                </button>
            </li>
        </ul>

        <div class="tab-content bg-body-tertiary p-4 rounded-4 border" id="productTabsContent">
            <%# Tab 1: Description %>
            <div class="tab-pane fade show active" id="tab-overview" role="tabpanel" aria-labelledby="overview-tab">
                <h3 class="h5 fw-bold mb-3">About this product</h3>
                <p class="text-body-secondary lead fs-6"><%= product.description %></p>
                <div class="row g-3 mt-2">
                    <div class="col-md-6">
                        <div class="card p-3 border-0 shadow-sm bg-body">
                            <h6 class="fw-bold text-primary mb-2"><i class="bi bi-star-fill me-2"></i>Premium Build Quality</h6>
                            <p class="small text-muted mb-0">Engineered with high standard materials for longevity, comfort, and reliable everyday use.</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card p-3 border-0 shadow-sm bg-body">
                            <h6 class="fw-bold text-primary mb-2"><i class="bi bi-patch-check-fill me-2"></i>Official Guarantee</h6>
                            <p class="small text-muted mb-0">Covered by our authentic manufacturer warranty with dedicated customer support.</p>
                        </div>
                    </div>
                </div>
            </div>

            <%# Tab 2: Specifications %>
            <div class="tab-pane fade" id="tab-specs" role="tabpanel" aria-labelledby="specs-tab">
                <h3 class="h5 fw-bold mb-3">Technical Specifications</h3>
                <% const specs = product.specifications || {}; const specKeys = Object.keys(specs); %>
                <table class="table table-striped table-bordered bg-body mb-0">
                    <tbody>
                        <tr>
                            <th scope="row" class="text-secondary-emphasis w-25">Product Name</th>
                            <td><%= product.name %></td>
                        </tr>
                        <tr>
                            <th scope="row" class="text-secondary-emphasis">SKU Reference</th>
                            <td><%= product.sku %></td>
                        </tr>
                        <tr>
                            <th scope="row" class="text-secondary-emphasis">Category</th>
                            <td><%= product.category ? product.category.name : 'General' %></td>
                        </tr>
                        <tr>
                            <th scope="row" class="text-secondary-emphasis">Brand</th>
                            <td><%= product.brand ? product.brand.name : 'ShopSphere' %></td>
                        </tr>
                        <% specKeys.forEach((key) => { %>
                            <tr>
                                <th scope="row" class="text-secondary-emphasis"><%= key %></th>
                                <td><%= specs[key] %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

            <%# Tab 3: Shipping & Returns %>
            <div class="tab-pane fade" id="tab-shipping" role="tabpanel" aria-labelledby="shipping-tab">
                <h3 class="h5 fw-bold mb-3">Shipping &amp; Delivery Information</h3>
                <div class="row g-4">
                    <div class="col-md-6">
                        <h6 class="fw-bold"><i class="bi bi-airplane me-2 text-primary"></i>Standard Delivery</h6>
                        <p class="small text-muted">Orders placed Monday through Friday are processed within 24 hours. Standard transit time is 2 to 4 business days.</p>
                    </div>
                    <div class="col-md-6">
                        <h6 class="fw-bold"><i class="bi bi-arrow-repeat me-2 text-primary"></i>30-Day Hassle-Free Returns</h6>
                        <p class="small text-muted">If you are not 100% satisfied with your purchase, you can return items within 30 days of delivery in their original condition.</p>
                    </div>
                </div>
            </div>

            <%# Tab 4: Reviews & AI %>
            <div class="tab-pane fade" id="tab-reviews" role="tabpanel" aria-labelledby="reviews-tab">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
            <div class="d-flex align-items-center gap-3">
                <h2 id="reviews-heading" class="h4 fw-bold mb-0"><%= t('product.tab_reviews', 'Customer reviews') %></h2>
                <%- include('../partials/star-rating', { rating: product.rating, count: product.reviewCount }) %>
            </div>
        </div>

        <%# AI Review Highlights Card %>
        <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-body-tertiary ai-review-summary-card">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary text-white d-flex align-items-center gap-1 px-2 py-1">
                        <i class="bi bi-stars"></i> <%= t('product.ai_summary', 'AI Summary') %>
                    </span>
                    <strong class="small text-secondary-emphasis">Customer Sentiment Analysis</strong>
                </div>
                <span class="badge bg-success-subtle text-success-emphasis fw-semibold small">
                    <i class="bi bi-hand-thumbs-up me-1"></i><%= t('product.sentiment_positive', `${Math.min(Math.round((product.rating / 5) * 100), 100)}% Positive`, { percent: Math.min(Math.round((product.rating / 5) * 100), 100) }) %>
                </span>
            </div>
            <p class="small text-body mb-2">
                <%= reviews.length > 0
                    ? `Based on ${reviews.length} verified review${reviews.length > 1 ? 's' : ''}, customers consistently praise the ${product.name} for its reliable build quality, true-to-description performance, and dependable value.`
                    : `No customer feedback yet for ${product.name}. This is a brand new arrival covered by standard manufacturer warranty.` %>
            </p>
            <div class="d-flex flex-wrap gap-2 pt-1" style="font-size: 0.75rem;">
                <span class="badge bg-body border text-body-secondary"><i class="bi bi-check2-circle text-success me-1"></i>High satisfaction</span>
                <span class="badge bg-body border text-body-secondary"><i class="bi bi-check2-circle text-success me-1"></i>Quality materials</span>
                <span class="badge bg-body border text-body-secondary"><i class="bi bi-check2-circle text-success me-1"></i>Fast shipping</span>
            </div>
        </div>

        <% if (reviews.length === 0) { %>
            <div class="empty-state mb-4">
                <i class="bi bi-chat-square-text empty-state-icon" aria-hidden="true"></i>
                <p class="mb-1 fw-semibold"><%= t('catalog.no_products', 'No reviews yet') %></p>
                <p class="small text-secondary-emphasis mb-0">Be the first verified buyer to share your experience.</p>
            </div>
        <% } else { %>
            <div class="review-list mb-4">
                <% reviews.forEach((review) => { %>
                    <%- include('../partials/review-item', { review, mine: false }) %>
                <% }) %>
            </div>
        <% } %>

        <%# --------------------- Write / manage own review ---------------------- %>
        <% if (!currentUser) { %>
            <p class="small text-secondary-emphasis">
                <a href="/auth/login?redirect=<%= encodeURIComponent('/products/' + product.slug) %>" class="link-primary"><%= t('nav.login', 'Log in') %></a>
                to write a review.
            </p>
        <% } else if (eligibility.allowed) { %>
            <div class="card-panel review-form-panel">
                <h3 id="review-form-heading" class="h6 fw-bold mb-3 js-form-title"><%= t('product.write_review', 'Write your review') %></h3>
                <form id="review-form" novalidate
                      data-product="<%= product._id %>"
                      data-slug="<%= product.slug %>">
                    <fieldset class="mb-3">
                        <legend class="form-label mb-1 small fw-semibold"><%= t('product.your_rating', 'Your rating') %></legend>
                        <div class="star-input" role="radiogroup" aria-label="Rating">
                            <% [1, 2, 3, 4, 5].forEach((value) => { %>
                                <button type="button" class="star-btn" data-value="<%= value %>"
                                        aria-label="<%= value %> star<%= value > 1 ? 's' : '' %>">
                                    <i class="bi bi-star" aria-hidden="true"></i>
                                </button>
                            <% }) %>
                            <input type="hidden" id="review-rating" value="">
                        </div>
                    </fieldset>
                    <div class="mb-2">
                        <label for="review-comment" class="form-label small fw-semibold"><%= t('product.your_comment', 'Your comment') %></label>
                        <textarea id="review-comment" name="comment" class="form-control" rows="3"
                                  minlength="10" maxlength="2000"
                                  placeholder="What did you like or dislike?" required></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm px-4 js-review-submit"><%= t('product.submit_review', 'Submit review') %></button>
                    <button type="button" class="btn btn-link btn-sm d-none js-review-cancel-edit">Cancel edit</button>
                </form>
            </div>
        <% } else if (myReview) { %>
            <div class="card-panel review-form-panel">
                <h3 class="h6 fw-bold mb-3"><%= t('product.tab_reviews', 'Your review') %></h3>
                <% if (!myReview.isApproved) { %>
                    <p class="small text-warning-emphasis">
                        <i class="bi bi-hourglass-split me-1" aria-hidden="true"></i>
                        Your review is awaiting approval and will appear here once published.
                    </p>
                <% } %>
                <%- include('../partials/review-item', { review: myReview, mine: true }) %>
            </div>
        <% } else if (eligibility.reason === 'purchase_required') { %>
            <p class="small text-secondary-emphasis mb-0">
                <i class="bi bi-shield-check me-1" aria-hidden="true"></i>
                Only verified buyers can review this product.
            </p>
        <% } %>
            </div>
        </div>
    </section>

    <%# --------------------- Frequently Bought Together -------------------- %>
    <% if (typeof frequentlyBought !== 'undefined' && frequentlyBought && frequentlyBought.bundledProduct) { %>
        <section class="mt-5 p-4 rounded-4 border bg-body-tertiary shadow-sm" aria-labelledby="bundle-heading">
            <div class="d-flex align-items-center gap-2 mb-3">
                <span class="badge bg-warning text-dark fw-bold"><i class="bi bi-lightning-charge-fill me-1"></i>Bundle & Save 10%</span>
                <h2 id="bundle-heading" class="h5 fw-bold mb-0">Frequently Bought Together</h2>
            </div>

            <div class="row align-items-center g-4">
                <div class="col-12 col-lg-7">
                    <div class="d-flex align-items-center gap-3 flex-wrap">
                        <div class="d-flex align-items-center gap-2 p-2 rounded-3 border bg-body" style="max-width: 220px;">
                            <img src="<%= (product.images && product.images[0]) || '/images/placeholder.svg' %>" alt="<%= product.name %>" style="width: 50px; height: 50px; object-fit: contain;">
                            <div class="min-w-0">
                                <p class="small fw-bold mb-0 text-truncate"><%= product.name %></p>
                                <span class="small text-primary fw-bold">$<%= (product.discountPrice != null ? product.discountPrice : product.price).toFixed(2) %></span>
                            </div>
                        </div>

                        <span class="fs-4 fw-bold text-muted">+</span>

                        <div class="d-flex align-items-center gap-2 p-2 rounded-3 border bg-body" style="max-width: 220px;">
                            <a href="/products/<%= frequentlyBought.bundledProduct.slug %>">
                                <img src="<%= (frequentlyBought.bundledProduct.images && frequentlyBought.bundledProduct.images[0]) || '/images/placeholder.svg' %>" alt="<%= frequentlyBought.bundledProduct.name %>" style="width: 50px; height: 50px; object-fit: contain;">
                            </a>
                            <div class="min-w-0">
                                <p class="small fw-bold mb-0 text-truncate"><a href="/products/<%= frequentlyBought.bundledProduct.slug %>" class="text-reset text-decoration-none"><%= frequentlyBought.bundledProduct.name %></a></p>
                                <span class="small text-primary fw-bold">$<%= (frequentlyBought.bundledProduct.discountPrice != null ? frequentlyBought.bundledProduct.discountPrice : frequentlyBought.bundledProduct.price).toFixed(2) %></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-5 text-lg-end">
                    <div class="d-inline-block text-lg-end">
                        <div class="mb-2">
                            <span class="text-muted text-decoration-line-through small me-2">$<%= frequentlyBought.combinedRegular.toFixed(2) %></span>
                            <span class="fs-4 fw-bold text-success">$<%= frequentlyBought.bundlePrice.toFixed(2) %></span>
                            <small class="d-block text-success fw-semibold">You save $<%= frequentlyBought.savings.toFixed(2) %></small>
                        </div>
                        <button type="button" class="btn btn-primary btn-sm px-4 js-add-bundle"
                                data-prod-1="<%= product._id %>"
                                data-prod-2="<%= frequentlyBought.bundledProduct._id %>">
                            <i class="bi bi-bag-plus-fill me-1"></i> Add Both to Cart
                        </button>
                    </div>
                </div>
            </div>
        </section>
    <% } %>

    <%# ----------------------------- Related -------------------------------- %>
    <% if (related && related.length > 0) { %>
        <section class="mt-5" aria-labelledby="related-heading">
            <h2 id="related-heading" class="h4 fw-bold mb-3"><%= t('product.you_may_also_like', 'You may also like') %></h2>
            <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3">
                <% related.forEach((relatedProduct) => { %>
                    <div class="col">
                        <%- include('../partials/product-card', { product: relatedProduct }) %>
                    </div>
                <% }) %>
            </div>
        </section>
    <% } %>

    <%- include('../partials/recently-viewed') %>

    <%# --------------------- Sticky Mobile Add-to-Cart Bar -------------------- %>
    <div class="mobile-sticky-bar d-lg-none d-none position-fixed bottom-0 start-0 end-0 bg-body border-top p-2 px-3 shadow-lg z-3" id="mobile-sticky-bar">
        <div class="d-flex align-items-center justify-content-between gap-2">
            <div class="d-flex align-items-center gap-2 min-w-0">
                <img src="<%= images[0] %>" alt="<%= product.name %>" class="rounded border p-1 bg-body-tertiary" style="width: 44px; height: 44px; object-fit: contain;">
                <div class="min-w-0">
                    <p class="mb-0 small fw-bold text-truncate" style="max-width: 150px;"><%= product.name %></p>
                    <span class="fw-bold text-primary small price-current"><%= formatPrice(product.effectivePrice) %></span>
                </div>
            </div>
            <% if (outOfStock) { %>
                <button class="btn btn-secondary btn-sm" disabled><%= t('product.out_of_stock', 'Out of stock') %></button>
            <% } else { %>
                <button type="button" class="btn btn-primary btn-sm px-3 js-add-to-cart" data-product-id="<%= product._id %>">
                    <i class="bi bi-cart-plus me-1"></i><%= t('product.add_to_cart', 'Add to cart') %>
                </button>
            <% } %>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const variantBtns = document.querySelectorAll('.js-variant-btn');
    if (!variantBtns.length) return;

    const priceDisplay = document.querySelector('.price-current');
    const addToCartBtn = document.querySelector('.js-add-to-cart');
    const qtyInput = document.querySelector('.js-qty');
    const stepper = document.querySelector('.qty-stepper');

    variantBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
            variantBtns.forEach((b) => b.classList.remove('active'));
            btn.classList.add('active');

            const price = parseFloat(btn.dataset.price);
            const stock = parseInt(btn.dataset.stock, 10);
            const variantId = btn.dataset.variantId;

            if (priceDisplay && !isNaN(price)) {
                priceDisplay.textContent = '$' + price.toFixed(2);
            }

            if (addToCartBtn) {
                addToCartBtn.dataset.variantId = variantId;
                addToCartBtn.dataset.stock = stock;
                if (stock <= 0) {
                    addToCartBtn.disabled = true;
                    addToCartBtn.innerHTML = '<i class="bi bi-cart-x me-2"></i>Option out of stock';
                } else {
                    addToCartBtn.disabled = false;
                    addToCartBtn.innerHTML = '<i class="bi bi-cart-plus me-2"></i>Add to cart';
                }
            }

            if (qtyInput) {
                qtyInput.max = Math.max(stock, 1);
                if (parseInt(qtyInput.value, 10) > stock) {
                    qtyInput.value = Math.max(stock, 1);
                }
            }
            if (stepper) {
                stepper.dataset.stock = stock;
            }
        });
    });
});
</script>

