<%# ---------- Reset password page ---------- %>
<% const tokenValue = typeof resetToken === 'string' ? resetToken : ''; %>
<section class="auth-wrapper"
         data-reset-token="<%= tokenValue %>"
         id="reset-page">
    <div class="auth-card">
        <% if (!tokenValue) { %>
            <div class="alert alert-warning small" role="alert">
                Missing reset token. Please use the link from your email,
                or request a new one below.
            </div>
            <div class="text-center">
                <a href="/auth/forgot-password" class="btn btn-outline-primary btn-sm">Request a new link</a>
            </div>
        <% } else { %>
            <div class="text-center mb-4">
                <i class="bi bi-shield-lock auth-brand-icon" aria-hidden="true"></i>
                <h1 class="h4 fw-bold mt-2 mb-1">Choose a new password</h1>
                <p class="text-secondary-emphasis small mb-0">Make it strong and unique.</p>
            </div>

            <form id="reset-form" novalidate aria-label="Reset password form">
                <div class="mb-3">
                    <label for="reset-password" class="form-label">New password</label>
                    <div class="input-group">
                        <input type="password" class="form-control" id="reset-password" name="password"
                               autocomplete="new-password" required minlength="8"
                               pattern="(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{8,}"
                               title="At least 8 characters with one lowercase, one uppercase and one digit">
                        <button class="btn btn-outline-secondary password-toggle" type="button"
                                data-target="reset-password" aria-label="Show password">
                            <i class="bi bi-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="invalid-feedback" data-error-for="password"></div>
                </div>

                <div class="mb-4">
                    <label for="reset-confirm-password" class="form-label">Confirm new password</label>
                    <input type="password" class="form-control" id="reset-confirm-password"
                           name="confirmPassword" autocomplete="new-password" required minlength="8">
                    <div class="invalid-feedback" data-error-for="confirmPassword"></div>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                    Update password
                </button>
            </form>
        <% } %>
    </div>
</section>
