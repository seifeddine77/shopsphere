<%# ---------- Login page ---------- %>
<section class="auth-wrapper">
    <div class="auth-card">
        <div class="text-center mb-4">
            <i class="bi bi-bag-heart-fill auth-brand-icon" aria-hidden="true"></i>
            <h1 class="h4 fw-bold mt-2 mb-1"><%= t('nav.login', 'Welcome back') %></h1>
            <p class="text-secondary-emphasis small mb-0"><%= t('cart.checkout_as_guest', 'Log in to continue shopping') %></p>
        </div>

        <form id="login-form" novalidate aria-label="Login form">
            <div class="mb-3">
                <label for="login-email" class="form-label"><%= t('profile.email', 'Email address') %></label>
                <input type="email" class="form-control" id="login-email" name="email"
                       autocomplete="email" required>
                <div class="invalid-feedback" data-error-for="email"></div>
            </div>

            <div class="mb-3">
                <label for="login-password" class="form-label"><%= t('profile.current_password', 'Password') %></label>
                <div class="input-group">
                    <input type="password" class="form-control" id="login-password" name="password"
                           autocomplete="current-password" required minlength="8">
                    <button class="btn btn-outline-secondary password-toggle" type="button"
                            data-target="login-password" aria-label="Show password">
                        <i class="bi bi-eye" aria-hidden="true"></i>
                    </button>
                </div>
                <div class="invalid-feedback" data-error-for="password"></div>
            </div>

            <div class="d-flex justify-content-end mb-3">
                <a href="/auth/forgot-password" class="small link-primary text-decoration-none">Forgot password?</a>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                <%= t('nav.login', 'Log in') %>
            </button>
        </form>

        <p class="text-center small mt-4 mb-0">
            New to ShopSphere?
            <a href="/auth/register" class="link-primary fw-semibold text-decoration-none"><%= t('nav.register', 'Create an account') %></a>
        </p>
    </div>
</section>

