<%# ---------- Cart page (/cart) ----------
    Expects: cart { items[{product, quantity, lineTotal, available}], itemCount, subtotal } %>

<div class="container py-4">
    <h1 class="h3 fw-bold mb-4">
        <%= t('cart.title', 'Your cart') %>
        <% if (cart.itemCount > 0) { %>
            <span class="text-secondary-emphasis fs-6 fw-normal">(<%= cart.itemCount %> <%= cart.itemCount === 1 ? t('cart.items_count', 'item').replace(/[()]/g, '') : t('cart.items_count_plural', 'items').replace(/[()]/g, '') %>)</span>
        <% } %>
    </h1>

    <% if (cart.items.length === 0) { %>
        <div class="empty-state">
            <i class="bi bi-cart-x empty-state-icon" aria-hidden="true"></i>
            <p class="mb-1 fw-semibold"><%= t('cart.empty_title', 'Your cart is empty') %></p>
            <p class="small text-secondary-emphasis"><%= t('cart.empty_desc', 'Browse the catalog and find something you love.') %></p>
            <a href="/products" class="btn btn-primary mt-2 px-4"><%= t('cart.start_shopping', 'Start shopping') %></a>
        </div>
    <% } else { %>
        <div class="row g-4">
            <%# ------------------------------ Items ------------------------------ %>
            <div class="col-12 col-lg-8">
                <% 
                   const freeShippingThreshold = 100;
                   const diffToFree = Math.max(0, freeShippingThreshold - (cart.subtotal || 0));
                   const progressPercent = Math.min(100, Math.round(((cart.subtotal || 0) / freeShippingThreshold) * 100));
                %>
                <div class="free-shipping-box mb-3">
                    <div class="d-flex align-items-center justify-content-between mb-1 small fw-semibold">
                        <span>
                            <% if (diffToFree <= 0) { %>
                                <i class="bi bi-gift-fill text-success me-1"></i><%= t('cart.free_shipping_unlocked', '🎉 You unlocked Free Express Shipping!') %>
                            <% } else { %>
                                <i class="bi bi-truck text-primary me-1"></i><%= t('cart.free_shipping_remaining', `Add ${formatPrice(diffToFree)} more to unlock Free Express Shipping!`, { amount: formatPrice(diffToFree) }) %>
                            <% } %>
                        </span>
                        <span class="text-muted"><%= progressPercent %>%</span>
                    </div>
                    <div class="free-shipping-progress">
                        <div class="free-shipping-progress-bar" style="width: <%= progressPercent %>%;"></div>
                    </div>
                </div>

                <div class="cart-list">
                    <% cart.items.forEach((item) => { %>
                        <div class="cart-row <%= item.available ? '' : 'cart-row-disabled' %>"
                             data-product-id="<%= item.product._id %>">
                            <a href="/products/<%= item.product.slug %>" class="cart-thumb" tabindex="-1" aria-hidden="true">
                                <img src="<%= item.product.images && item.product.images[0] || '/images/placeholder.svg' %>"
                                     alt="" loading="lazy">
                            </a>

                            <div class="cart-info">
                                <a href="/products/<%= item.product.slug %>" class="cart-name"><%= item.product.name %></a>
                                <p class="small text-secondary-emphasis mb-0">
                                    <%= formatPrice(item.product.effectivePrice) %> <%= t('cart.unit', '/ unit') %>
                                    <% if (!item.available) { %>
                                        · <span class="text-danger"><%= t('cart.no_longer_available', 'no longer available') %></span>
                                    <% } else if (item.product.stock < 5) { %>
                                        · <%= t('cart.only_left', `only ${item.product.stock} left`, { count: item.product.stock }) %>
                                    <% } %>
                                </p>
                            </div>

                            <div class="qty-stepper input-group qty-stepper-sm" data-stock="<%= Math.max(item.product.stock, item.quantity) %>">
                                <button type="button" class="btn btn-outline-secondary js-cart-decrease"
                                        data-product-id="<%= item.product._id %>" aria-label="Decrease quantity">&minus;</button>
                                <label class="visually-hidden" for="qty-<%= item.product._id %>">Quantity</label>
                                <input type="number" id="qty-<%= item.product._id %>"
                                       class="form-control text-center js-cart-qty"
                                       data-product-id="<%= item.product._id %>"
                                       value="<%= item.quantity %>" min="1" max="99"
                                       <%= item.available ? '' : 'disabled' %>>
                                <button type="button" class="btn btn-outline-secondary js-cart-increase"
                                        data-product-id="<%= item.product._id %>" aria-label="Increase quantity">+</button>
                            </div>

                            <p class="cart-line-total fw-bold mb-0"><%= formatPrice(item.lineTotal) %></p>

                            <button type="button" class="btn btn-outline-danger btn-sm js-remove-item"
                                     data-product-id="<%= item.product._id %>"
                                     aria-label="Remove <%= item.product.name %> from cart">
                                <i class="bi bi-trash" aria-hidden="true"></i>
                            </button>
                        </div>
                    <% }) %>
                </div>

                <button type="button" class="btn btn-link btn-sm text-decoration-none px-0 mt-3 js-clear-cart text-danger">
                    <i class="bi bi-x-circle me-1" aria-hidden="true"></i><%= t('cart.clear_cart', 'Clear the whole cart') %>
                </button>
            </div>

            <%# ----------------------------- Summary ----------------------------- %>
            <div class="col-12 col-lg-4">
                <div class="cart-summary">
                    <h2 class="h5 fw-bold mb-3"><%= t('cart.summary', 'Summary') %></h2>
                    <dl class="mb-4">
                        <dt class="d-flex justify-content-between fw-normal">
                            <span><%= t('cart.items', 'Items') %></span><span><%= cart.itemCount %></span>
                        </dt>
                        <dt class="d-flex justify-content-between fw-normal">
                            <span><%= t('cart.subtotal', 'Subtotal') %></span>
                            <strong class="text-dark"><%= formatPrice(cart.subtotal) %></strong>
                        </dt>
                        <dt class="d-flex justify-content-between fw-normal">
                            <span><%= t('cart.shipping', 'Shipping') %></span>
                            <span><%= t('cart.shipping_calc', 'calculated at checkout') %></span>
                        </dt>
                    </dl>

                    <a href="/checkout" class="btn btn-primary btn-lg w-100 fw-semibold">
                        <%= t('cart.proceed_checkout', 'Proceed to checkout') %>
                    </a>
                    <a href="/products" class="btn btn-outline-secondary w-100 mt-2"><%= t('cart.continue_shopping', 'Continue shopping') %></a>
                </div>
            </div>
        </div>
    <% } %>
</div>
