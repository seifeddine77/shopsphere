<%# Server-side pagination.
    Expects: pagination (from utils/pagination), baseQuery (querystring without `page`) %>
<%
  const totalPages = pagination.totalPages;
  const current = pagination.currentPage;

  // Windowed page list: first, last and +-2 around current, with ellipses
  const items = [];
  for (let n = 1; n <= totalPages; n += 1) {
    if (n === 1 || n === totalPages || Math.abs(n - current) <= 2) {
      items.push({ type: 'page', n });
    } else if (items[items.length - 1].type !== 'ellipsis') {
      items.push({ type: 'ellipsis' });
    }
  }

  const urlFor = (page) =>
    '?' + [locals.baseQuery, 'page=' + page].filter(Boolean).join('&');
%>
<% if (totalPages > 1) { %>
<nav class="mt-4" aria-label="Catalog pages">
    <ul class="pagination justify-content-center flex-wrap">
        <li class="page-item <%= pagination.hasPreviousPage ? '' : 'disabled' %>">
            <a class="page-link"
               href="<%= urlFor(current - 1) %>"
               <%- pagination.hasPreviousPage ? '' : 'tabindex="-1" aria-disabled="true"' %>>
                <i class="bi <%= typeof dir !== 'undefined' && dir === 'rtl' ? 'bi-chevron-right' : 'bi-chevron-left' %>" aria-hidden="true"></i>
                <span class="visually-hidden"><%= t('pagination.previous', 'Previous') %></span>
            </a>
        </li>

        <% items.forEach((item) => { %>
            <% if (item.type === 'ellipsis') { %>
                <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
            <% } else { %>
                <li class="page-item <%= item.n === current ? 'active' : '' %>"
                    <%- item.n === current ? 'aria-current="page"' : '' %>>
                    <a class="page-link" href="<%= urlFor(item.n) %>"><%= item.n %></a>
                </li>
            <% } %>
        <% }) %>

        <li class="page-item <%= pagination.hasNextPage ? '' : 'disabled' %>">
            <a class="page-link"
               href="<%= urlFor(current + 1) %>"
               <%- pagination.hasNextPage ? '' : 'tabindex="-1" aria-disabled="true"' %>>
                <i class="bi <%= typeof dir !== 'undefined' && dir === 'rtl' ? 'bi-chevron-left' : 'bi-chevron-right' %>" aria-hidden="true"></i>
                <span class="visually-hidden"><%= t('pagination.next', 'Next') %></span>
            </a>
        </li>
    </ul>
</nav>
<% } %>

