<%# Reusable product card.
    Expects: product (plain JSON from the product service) %>
<%
  const hasDiscount = product.discountPrice != null;
  const isNew = product.createdAt
    && (Date.now() - new Date(product.createdAt).getTime()) < 30 * 24 * 60 * 60 * 1000;
  const outOfStock = !product.stock || product.stock <= 0;
  const imageUrl = (product.images && product.images[0]) || '/images/placeholder.svg';
%>
<article class="product-card h-100" data-product-id="<%= product._id %>">
    <div class="product-media">
        <a href="/products/<%= product.slug %>" tabindex="-1" aria-hidden="true">
            <img src="<%= imageUrl %>" alt="<%= product.name %>" loading="lazy">
        </a>
        <% if (hasDiscount) { %>
            <span class="badge badge-discount">-<%= discountPercent(product) %>%</span>
        <% } else if (isNew) { %>
            <span class="badge badge-new">New</span>
        <% } %>
        <% if (outOfStock) { %>
            <span class="badge badge-out"><%= t('product.out_of_stock', 'Out of stock') %></span>
        <% } %>
        <button type="button" class="btn btn-light btn-sm btn-quick-view js-quick-view"
                data-product-slug="<%= product.slug %>" aria-label="Quick view <%= product.name %>">
            <i class="bi bi-eye me-1"></i><%= t('product.quick_view', 'Quick View') %>
        </button>
    </div>

    <div class="product-body">
        <div class="d-flex align-items-center justify-content-between mb-1">
            <% if (product.brand && product.brand.name) { %>
                <p class="product-brand mb-0"><%= product.brand.name %></p>
            <% } else { %>
                <span></span>
            <% } %>
            <% if (product.stock > 5) { %>
                <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle" style="font-size: 0.65rem;"><i class="bi bi-check2 me-1"></i><%= t('product.in_stock', 'In Stock') %></span>
            <% } else if (product.stock > 0) { %>
                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle" style="font-size: 0.65rem;"><i class="bi bi-exclamation-triangle me-1"></i><%= t('cart.only_left', `Only ${product.stock} left`, { count: product.stock }) %></span>
            <% } %>
        </div>
        <h3 class="product-title">
            <a href="/products/<%= product.slug %>"><%= product.name %></a>
        </h3>

        <%- include('star-rating', { rating: product.rating, count: product.reviewCount }) %>

        <div class="product-price">
            <span class="price-current"><%= formatPrice(product.effectivePrice) %></span>
            <% if (hasDiscount) { %>
                <s class="price-old"><%= formatPrice(product.price) %></s>
            <% } %>
        </div>
    </div>

    <div class="product-actions">
        <% if (outOfStock) { %>
            <a href="/products/<%= product.slug %>" class="btn btn-outline-secondary w-100 btn-sm">
                <i class="bi bi-bell me-1" aria-hidden="true"></i><%= t('product.notify_me', 'Notify Me') %>
            </a>
        <% } else { %>
            <button type="button" class="btn btn-primary w-100 js-add-to-cart"
                    data-product-id="<%= product._id %>">
                <i class="bi bi-cart-plus me-1" aria-hidden="true"></i><%= t('product.add_to_cart', 'Add to cart') %>
            </button>
        <% } %>
        <button type="button" class="btn btn-outline-secondary btn-icon js-add-to-wishlist"
                data-product-id="<%= product._id %>"
                aria-label="Add <%= product.name %> to wishlist" title="<%= t('product.save_wishlist', 'Add to wishlist') %>">
            <i class="bi bi-heart" aria-hidden="true"></i>
        </button>
        <button type="button" class="btn btn-outline-secondary btn-icon js-add-to-compare"
                data-product-id="<%= product._id %>"
                aria-label="Compare <%= product.name %>" title="<%= t('product.compare', 'Compare product') %>">
            <i class="bi bi-arrow-left-right" aria-hidden="true"></i>
        </button>
    </div>
</article>


