<%# Floating Dock Bar for Product Comparison %>
<div class="position-fixed bottom-0 start-50 translate-middle-x mb-3 z-3 d-none" id="compare-floating-dock" style="max-width: 92vw; width: 560px;">
    <div class="card border-0 shadow-lg rounded-pill p-2 px-3 bg-dark text-white d-flex flex-row align-items-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-primary rounded-pill px-2 py-1" id="dock-compare-count">0/4</span>
            <div class="d-flex align-items-center gap-1" id="dock-compare-thumbnails"></div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-link text-white-50 text-decoration-none btn-sm p-0 me-1" id="dock-clear-btn" title="Clear comparison">
                <i class="bi bi-x-circle"></i>
            </button>
            <a href="/compare" class="btn btn-primary btn-sm rounded-pill px-3 fw-semibold text-nowrap" id="dock-compare-link">
                Compare <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
    </div>
</div>
