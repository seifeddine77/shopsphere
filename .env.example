# ==============================================================================
# SHOPSPHERE — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in your production credentials:
#   cp .env.example .env

# --- Server & General ---
NODE_ENV=production
PORT=3000
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# --- Database (MongoDB Atlas) ---
# Replace with your MongoDB Atlas connection string:
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/shopsphere?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce

# --- Security & JWT (Min. 64 characters) ---
# Generated with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=89522186b9d4fac239fd032e8a843adedad20f10235d9244768d041d7035f0e4
JWT_EXPIRES_IN=7d
COOKIE_SECRET=ea3242b4778e7ba3869ee07f47ddd0934919346abbe8be8673788d09c4b31df2

# --- Stripe Payments ---
# Retrieve your keys from: https://dashboard.stripe.com/apikeys
# Webhook secret from: https://dashboard.stripe.com/webhooks
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_stripe_webhook_secret

# --- Shipping & Delivery Rules ---
SHIPPING_FLAT_RATE=5.99
SHIPPING_FREE_THRESHOLD=200

# --- Email Notifications (SMTP) ---
# Optional: Leave empty to log emails to console in development
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@your-domain.com
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=ShopSphere <no-reply@shopsphere.com>

# --- Cloudinary (Optional Image CDN) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
