# ============================================================
# Application
# ============================================================
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce

# Public base URL - used to build absolute links in emails
APP_URL=http://localhost:3000

# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000

# ============================================================
# Security (required from Phase 2 - Authentication onwards)
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================
JWT_SECRET=
JWT_EXPIRES_IN=7d
COOKIE_SECRET=

# ============================================================
# Shipping (Phase 6)
# ============================================================
SHIPPING_FLAT_RATE=5.99
SHIPPING_FREE_THRESHOLD=200

# ============================================================
# Email (used from Phase 10 - leave empty to log emails to console)
# ============================================================
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=E-Commerce <no-reply@localhost>

# ============================================================
# Payments (used from Phase 6 - architecture is provider-agnostic)
# Never store credit card information anywhere.
# Leave STRIPE_SECRET_KEY empty to use the simulated card gateway.
# When set, card orders create real PaymentIntents finalized via webhook.
# ============================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================================
# Image hosting (used from Phase 10 - leave empty to store images on local disk)
# ============================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
