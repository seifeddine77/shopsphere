{
  "name": "ecommerce",
  "version": "0.1.0",
  "description": "Production-ready e-commerce platform built with Node.js, Express, EJS and MongoDB",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/scripts/seed.js",
    "test": "cross-env NODE_ENV=test jest --runInBand --forceExit",
    "lint": "eslint .",
    "test:coverage": "cross-env NODE_ENV=test jest --runInBand --coverage"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ecommerce",
    "express",
    "ejs",
    "mongodb",
    "mvc"
  ],
  "license": "MIT",
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testTimeout": 120000
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "joi": "^18.2.5",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.5.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.20.1",
    "stripe": "^22.5.0",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^10.9.1",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  }
}
